[
  {
    "name": "static without beneficiary",
    "template": "*999*2#",
    "expected": "*999*2#"
  },
  {
    "name": "local beneficiary",
    "template": "*999*{{msisdn_local}}#",
    "beneficiary": "01-01-01-01-01",
    "expected": "*999*0101010101#"
  },
  {
    "name": "international beneficiary",
    "template": "*999*{{msisdn_local}}#",
    "beneficiary": "+225 07 07 07 07 07",
    "expected": "*999*0707070707#"
  },
  {
    "name": "numeric variables",
    "template": "*999*{{amount}}*{{offer_code}}*{{quantity}}#",
    "amount": 1000,
    "offer_code": "00123",
    "quantity": 2,
    "expected": "*999*1000*00123*2#"
  },
  {
    "name": "unknown variable",
    "template": "*999*{{secret}}#",
    "error": "unknown_variable"
  },
  {
    "name": "malformed variable",
    "template": "*999*{amount}#",
    "error": "invalid_template"
  },
  {
    "name": "missing number",
    "template": "*999*{{msisdn_local}}#",
    "error": "invalid_beneficiary"
  },
  {
    "name": "letters in number",
