  },
  {
    "name": "configured secret",
    "template": "*414*{{secret_code}}#",
    "secret_code": "123456",
    "expected": "*414*123456#"
  },
  {
    "name": "static operator code",
    "template": "*412*1#",
    "expected": "*412*1#"
  },
  {
    "name": "Orange leading hash",
    "template": "#154*1*{{msisdn_local}}#",
