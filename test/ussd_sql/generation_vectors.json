  },
  {
    "name": "missing amount",
    "template": "*999*{{amount}}#",
    "error": "missing_amount"
  },
  {
    "name": "zero amount",
    "template": "*999*{{amount}}#",
    "amount": 0,
    "error": "missing_amount"
  },
  {
    "name": "negative amount",
    "template": "*999*{{amount}}#",
    "amount": -1,
    "error": "missing_amount"
  },
  {
    "name": "large amount",
    "template": "*999*{{amount}}#",
    "amount": 100000001,
    "error": "missing_amount"
  },
  {
    "name": "missing offer code",
    "template": "*999*{{offer_code}}#",
    "error": "missing_offer_code"
  },
  {
    "name": "offer code injection",
    "template": "*999*{{offer_code}}#",
