    "quantity": -2,
    "error": "missing_quantity"
  },
  {
    "name": "URI syntax",
    "template": "tel:*999#",
    "error": "invalid_template"
  },
  {
    "name": "embedded hash",
    "template": "*999#*2#",
    "error": "invalid_template"
  },
  {
    "name": "newline",
    "template": "*999#\n",
    "error": "invalid_template"
  },
  {
    "name": "human beneficiary alias",
    "template": "*412*2*numéro_du_destinataire#",
    "beneficiary": "0101010101",
    "canonical": "*412*2*{{msisdn_local}}#",
    "expected": "*412*2*0101010101#"
  },
  {
    "name": "human amount alias",
    "template": "*133*5*NUMÉRO*montant#",
    "beneficiary": "0101010101",
    "amount": 1000,
    "canonical": "*133*5*{{msisdn_local}}*{{amount}}#",
    "expected": "*133*5*0101010101*1000#"
  },
  {
    "name": "default secret",
    "template": "*410*{{msisdn_local}}*{{amount}}*{{secret_code}}#",
