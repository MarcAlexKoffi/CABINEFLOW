// Copied as Dart by prepare_android_qa.ps1 into a disposable QA app with its own app ID.
// All repositories and notification payloads are synthetic; production is never initialized.
import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';
import 'package:google_fonts/google_fonts.dart';
// ignore: implementation_imports
import 'package:google_fonts/src/google_fonts_base.dart' as fonts;
import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:cabine_flow/core/theme/app_theme.dart';
import 'package:cabine_flow/core/notifications/izytel_notification_payload.dart';
