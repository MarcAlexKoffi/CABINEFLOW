rules_version = '2';
// PHASE 9E AUTO ASSIGNMENT FIX V2 - artefacts unidirectionnels

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function staffProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isStaff() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role in ['operator', 'supervisor', 'admin'];
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role == 'admin';
    }

    function isAgent() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role == 'agent';
    }

    function isCurrentAssignedAgent() {
      return isAgent()
        && resource.data.get('assignedAgentId', null) == request.auth.uid;
    }

    function isOrderOwner() {
      return isSignedIn()
        && resource.data.customerAuthUid == request.auth.uid;
    }

    function hasValidOrderKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'reference',
        'source',
        'customerAuthUid',
        'clientName',
        'clientWhatsappPhone',
        'service',
        'network',
        'operationType',
        'offerId',
        'offerLabel',
        'isCustomOffer',
        'amount',
        'beneficiaryPhone',
        'status',
        'paymentStatus',
        'createdAt',
        'updatedAt',
        'paymentRequestSentAt',
        'paymentDeclaredAt',
        'paymentPayerName',
        'paymentPayerPhone',
        'paymentApproximateTime',
        'paymentDeclaredReference',
        'expiresAt',
        'expiredAt',
        'paymentConfirmedAt',
        'paidAt',
        'paymentReference',
        'originalWhatsappMessage',
        'internalNotes',
        'takenByUserId',
        'takenAt',
        'completedAt',
        'failureReason',
        'observation',
        'customerConfirmationStatus',
        'customerConfirmationCompletedAt',
        'assignedAgentId',
        'assignedAgentName',
        'assignedByUserId',
        'assignedAt',
        'assignmentMode',
        'assignmentStatus',
        'lastAssignmentRefusalReason',
        'lastAssignmentRefusedAt',
        'lastAssignmentRefusedAgentId',
        'autoAssignmentRefusedAgentIds',
        'manualAssignmentRequired',
        'lastHoldReason',
        'lastHeldAt',
        'lastResumedAt',
        'lastEventId',
        'lastEventType',
        'lastEventAt'
      ]);
    }


    function hasValidOrderAssignmentValues() {
      return (
          request.resource.data.get('assignedAgentId', null) == null
          || request.resource.data.get('assignedAgentId', null) is string
        )
        && (
          request.resource.data.get('assignedAgentName', null) == null
          || request.resource.data.get('assignedAgentName', null) is string
        )
        && (
          request.resource.data.get('assignedByUserId', null) == null
          || request.resource.data.get('assignedByUserId', null) is string
        )
        && (
          request.resource.data.get('assignedAt', null) == null
          || request.resource.data.get('assignedAt', null) is timestamp
        )
        && (
          request.resource.data.get('assignmentMode', null) == null
          || request.resource.data.get('assignmentMode', null) in [
            'manual',
            'automatic'
          ]
        )
        && request.resource.data.get('assignmentStatus', 'unassigned') in [
          'unassigned',
          'assigned',
          'accepted',
          'refused'
        ]
        && (
          request.resource.data.get('lastAssignmentRefusalReason', null) == null
          || (
            request.resource.data.get('lastAssignmentRefusalReason', null) is string
            && request.resource.data.get('lastAssignmentRefusalReason', null).size() >= 3
            && request.resource.data.get('lastAssignmentRefusalReason', null).size() <= 500
          )
        )
        && (
          request.resource.data.get('lastAssignmentRefusedAt', null) == null
          || request.resource.data.get('lastAssignmentRefusedAt', null) is timestamp
        )
        && (
          request.resource.data.get('lastAssignmentRefusedAgentId', null) == null
          || request.resource.data.get('lastAssignmentRefusedAgentId', null) is string
        )
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []) is list
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []).size() <= 100
        && request.resource.data.get('manualAssignmentRequired', false) is bool
        && (
          request.resource.data.get('lastHoldReason', null) == null
          || (
            request.resource.data.get('lastHoldReason', null) is string
            && request.resource.data.get('lastHoldReason', null).size() >= 3
            && request.resource.data.get('lastHoldReason', null).size() <= 300
          )
        )
        && (
          request.resource.data.get('lastHeldAt', null) == null
          || request.resource.data.get('lastHeldAt', null) is timestamp
        )
        && (
          request.resource.data.get('lastResumedAt', null) == null
          || request.resource.data.get('lastResumedAt', null) is timestamp
        );
    }

    function hasValidOrderAuditValues() {
      return (
          request.resource.data.get('lastEventId', null) == null
          || (
            request.resource.data.get('lastEventId', null) is string
            && request.resource.data.get('lastEventId', null).size() >= 8
            && request.resource.data.get('lastEventId', null).size() <= 120
          )
        )
        && (
          request.resource.data.get('lastEventType', null) == null
          || request.resource.data.get('lastEventType', null) in [
            'ORDER_CREATED',
            'PAYMENT_DECLARED',
            'PAYMENT_CONFIRMED',
            'CREDIT_AUTHORIZED',
            'ASSIGNED',
            'ASSIGNMENT_ACCEPTED',
            'ASSIGNMENT_REFUSED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_RESUMED',
            'PROOF_ADDED',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED',
            'REASSIGNMENT_REQUESTED',
            'CUSTOMER_CONTACTED'
          ]
        )
        && (
          request.resource.data.get('lastEventAt', null) == null
          || request.resource.data.get('lastEventAt', null) is timestamp
        );
    }

    function hasValidCommonOrderValues() {
      return hasValidOrderKeys()
        && hasValidOrderAssignmentValues()
        && hasValidOrderAuditValues()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 12
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientWhatsappPhone is string
        && request.resource.data['service'] in [
          'unitTransfer',
          'internetSubscription',
          'calls',
          'other'
        ]
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.operationType in [
          'unitTransfer',
          'internetSubscription',
          'callBundle',
          'mixedBundle',
          'other'
        ]
        && (
          request.resource.data.offerId == null
          || request.resource.data.offerId is string
        )
        && request.resource.data.offerLabel is string
        && request.resource.data.offerLabel.size() >= 2
        && request.resource.data.offerLabel.size() <= 200
        && request.resource.data.isCustomOffer is bool
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.beneficiaryPhone is string
        && request.resource.data.expiresAt is timestamp
        && (
          request.resource.data.get('expiredAt', null) == null
          || request.resource.data.get('expiredAt', null) is timestamp
        )
        && request.resource.data.status in [
          'awaitingPayment',
          'paymentToVerify',
          'paidReady',
          'inProgress',
          'onHold',
          'awaitingCustomerConfirmation',
          'completed',
          'failed',
          'expired',
          'cancelled',
          'refundPending',
          'refunded'
        ]
        && request.resource.data.paymentStatus in [
          'notDeclared',
          'pending',
          'declared',
          'confirmed',
          'credit',
          'rejected',
          'expired'
        ]
        && request.resource.data.customerConfirmationStatus in [
          'pending',
          'sent',
          'skipped'
        ];
    }

    function paymentStatusAllowsProcessing(value) {
      return value in ['confirmed', 'credit'];
    }

    function hasMatchingOrderEvent(orderId, eventType) {
      let eventId = request.resource.data.get('lastEventId', null);
      let event = getAfter(
        /databases/$(database)/documents/orderEvents/$(eventId)
      ).data;

      return eventId is string
        && request.resource.data.get('lastEventType', null) == eventType
        && request.resource.data.get('lastEventAt', null) == request.time
        && event.orderId == orderId
        && event.orderReference == request.resource.data.reference
        && event.type == eventType
        && event.createdAt == request.time;
    }

    function auditLinkIsUnchanged() {
      return request.resource.data.get('lastEventId', null)
          == resource.data.get('lastEventId', null)
        && request.resource.data.get('lastEventType', null)
          == resource.data.get('lastEventType', null)
        && request.resource.data.get('lastEventAt', null)
          == resource.data.get('lastEventAt', null);
    }

    function isValidCustomerServiceOperationPair() {
      return (
        request.resource.data['service'] == 'unitTransfer'
        && request.resource.data.operationType == 'unitTransfer'
      ) || (
        request.resource.data['service'] == 'internetSubscription'
        && request.resource.data.operationType == 'internetSubscription'
      ) || (
        request.resource.data['service'] == 'calls'
        && request.resource.data.operationType in ['callBundle', 'mixedBundle']
      );
    }

    function activeOfferMatchesOrderSnapshot(offerId) {
      let offer = get(
        /databases/$(database)/documents/offers/$(offerId)
      ).data;

      return offer.isActive == true
        && offer.network == request.resource.data.network
        && offer['service'] == request.resource.data['service']
        && offer.catalogLabel == request.resource.data.offerLabel
        && offer.sellingPrice == request.resource.data.amount;
    }

    function isValidOfferSnapshotAtCreation() {
      let offerId = request.resource.data.offerId;

      return (
        request.resource.data.isCustomOffer == true
        && offerId == null
        && isValidCustomerServiceOperationPair()
      ) || (
        request.resource.data.isCustomOffer == false
        && request.resource.data['service'] == 'unitTransfer'
        && request.resource.data.operationType == 'unitTransfer'
        && offerId == null
      ) || (
        request.resource.data.isCustomOffer == false
        && request.resource.data['service'] in ['internetSubscription', 'calls']
        && isValidCustomerServiceOperationPair()
        && offerId is string
        && activeOfferMatchesOrderSnapshot(offerId)
      );
    }

    // Validation dédiée à la création Web. Elle correspond exactement au
    // document construit par FirestoreCustomerOrderRepository._buildOrderData
    // + les trois champs d'audit ajoutés par _auditLinkData.
    //
    // Important : aucune lecture de orderEvents n'est faite ici. Le document
    // ORDER_CREATED écrit dans le même batch possède sa propre règle stricte.
    // Cela évite qu'une création de commande dépende de l'autorisation d'une
    // autre création pendant l'évaluation du même batch.
    function isValidCustomerOrderCreation() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'reference',
          'source',
          'customerAuthUid',
          'clientName',
          'clientWhatsappPhone',
          'service',
          'network',
          'operationType',
          'offerId',
          'offerLabel',
          'isCustomOffer',
          'amount',
          'beneficiaryPhone',
          'status',
          'paymentStatus',
          'createdAt',
          'updatedAt',
          'paymentRequestSentAt',
          'paymentDeclaredAt',
          'paymentPayerName',
          'paymentPayerPhone',
          'paymentApproximateTime',
          'paymentDeclaredReference',
          'expiresAt',
          'expiredAt',
          'paymentConfirmedAt',
          'paidAt',
          'paymentReference',
          'originalWhatsappMessage',
          'internalNotes',
          'takenByUserId',
          'takenAt',
          'completedAt',
          'failureReason',
          'observation',
          'customerConfirmationStatus',
          'customerConfirmationCompletedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 12
        && request.resource.data.reference.size() <= 40
        && request.resource.data.source == 'customerWeb'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientWhatsappPhone is string
        && request.resource.data['service'] in [
          'unitTransfer',
          'internetSubscription',
          'calls'
        ]
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && isValidCustomerServiceOperationPair()
        && request.resource.data.offerLabel is string
        && request.resource.data.offerLabel.size() >= 2
        && request.resource.data.offerLabel.size() <= 200
        && request.resource.data.isCustomOffer is bool
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.beneficiaryPhone is string
        && isValidOfferSnapshotAtCreation()
        && request.resource.data.status == 'awaitingPayment'
        && request.resource.data.paymentStatus == 'notDeclared'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentRequestSentAt == null
        && request.resource.data.paymentDeclaredAt == null
        && request.resource.data.paymentPayerName == null
        && request.resource.data.paymentPayerPhone == null
        && request.resource.data.paymentApproximateTime == null
        && request.resource.data.paymentDeclaredReference == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiredAt == null
        && request.resource.data.paymentConfirmedAt == null
        && request.resource.data.paidAt == null
        && request.resource.data.paymentReference == null
        && request.resource.data.originalWhatsappMessage == null
        && request.resource.data.internalNotes == null
        && request.resource.data.takenByUserId == null
        && request.resource.data.takenAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.failureReason == null
        && request.resource.data.observation == null
        && request.resource.data.customerConfirmationStatus == 'pending'
        && request.resource.data.customerConfirmationCompletedAt == null
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId.size() >= 8
        && request.resource.data.lastEventId.size() <= 120
        && request.resource.data.lastEventType == 'ORDER_CREATED'
        && request.resource.data.lastEventAt == request.time;
    }

    function isValidStaffOfferReferenceAtCreation() {
      let offerId = request.resource.data.offerId;

      return request.resource.data.isCustomOffer == true
        || request.resource.data['service'] == 'unitTransfer'
        || (
          request.resource.data.isCustomOffer == false
          && offerId is string
          && exists(
            /databases/$(database)/documents/offers/$(offerId)
          )
          && get(
            /databases/$(database)/documents/offers/$(offerId)
          ).data.isActive == true
        );
    }

    function isValidStaffOrderCreation(orderId) {
      return isStaff()
        && hasValidCommonOrderValues()
        && isValidStaffOfferReferenceAtCreation()
        && request.resource.data.source == 'operatorApp'
        && request.resource.data.customerAuthUid == null
        && request.resource.data.status == 'awaitingPayment'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentRequestSentAt == null
        && request.resource.data.paymentDeclaredAt == null
        && request.resource.data.paymentPayerName == null
        && request.resource.data.paymentPayerPhone == null
        && request.resource.data.paymentApproximateTime == null
        && request.resource.data.paymentDeclaredReference == null
        && request.resource.data.get('expiredAt', null) == null
        && request.resource.data.paymentConfirmedAt == null
        && request.resource.data.paidAt == null
        && request.resource.data.paymentReference == null
        && request.resource.data.takenByUserId == null
        && request.resource.data.takenAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.failureReason == null
        && request.resource.data.observation == null
        && request.resource.data.customerConfirmationStatus == 'pending'
        && request.resource.data.customerConfirmationCompletedAt == null
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignedAgentName', null) == null
        && request.resource.data.get('assignedByUserId', null) == null
        && request.resource.data.get('assignedAt', null) == null
        && request.resource.data.get('assignmentMode', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('lastAssignmentRefusalReason', null) == null
        && request.resource.data.get('lastAssignmentRefusedAt', null) == null
        && request.resource.data.get('lastAssignmentRefusedAgentId', null) == null
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []).size() == 0
        && request.resource.data.get('manualAssignmentRequired', false) == false
        && request.resource.data.get('lastHoldReason', null) == null
        && request.resource.data.get('lastHeldAt', null) == null
        && request.resource.data.get('lastResumedAt', null) == null
        && hasMatchingOrderEvent(orderId, 'ORDER_CREATED');
    }

    function immutableCoreOrderFieldsAreUnchanged() {
      return request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.source == resource.data.source
        && request.resource.data.customerAuthUid == resource.data.customerAuthUid
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.clientWhatsappPhone == resource.data.clientWhatsappPhone
        && request.resource.data['service'] == resource.data['service']
        && request.resource.data.network == resource.data.network
        && request.resource.data.operationType == resource.data.operationType
        && request.resource.data.offerId == resource.data.offerId
        && request.resource.data.offerLabel == resource.data.offerLabel
        && request.resource.data.isCustomOffer == resource.data.isCustomOffer
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.beneficiaryPhone == resource.data.beneficiaryPhone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.originalWhatsappMessage == resource.data.originalWhatsappMessage;
    }

    function onlyStaffMutableFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt',
        'status',
        'paymentStatus',
        'paymentRequestSentAt',
        'expiredAt',
        'paymentConfirmedAt',
        'paidAt',
        'paymentReference',
        'internalNotes',
        'takenByUserId',
        'takenAt',
        'completedAt',
        'failureReason',
        'observation',
        'customerConfirmationStatus',
        'customerConfirmationCompletedAt',
        'assignedAgentId',
        'assignedAgentName',
        'assignedByUserId',
        'assignedAt',
        'assignmentMode',
        'assignmentStatus',
        'lastEventId',
        'lastEventType',
        'lastEventAt'
      ]);
    }

    function isValidStaffPaymentConfirmation(orderId) {
      // Vérifie d'abord l'état de la commande. Ainsi une affectation d'une
      // commande déjà paidReady n'effectue aucune lecture /users inutile ici.
      return resource.data.status in [
          'awaitingPayment',
          'paymentToVerify',
          'expired'
        ]
        && resource.data.paymentStatus in [
          'pending',
          'declared',
          'notDeclared',
          'expired'
        ]
        && isStaff()
        && request.resource.data.status == 'paidReady'
        && request.resource.data.paymentStatus == 'confirmed'
        && request.resource.data.get('paidAt', null) is timestamp
        && request.resource.data.get('paymentConfirmedAt', null) == request.time
        && request.resource.data.get('paymentReference', null) is string
        && request.resource.data.get('paymentReference', null).size() >= 3
        && request.resource.data.get('paymentReference', null).size() <= 120
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'paidAt',
          'paymentConfirmedAt',
          'paymentReference',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PAYMENT_CONFIRMED');
    }

    // PHASE 13D - vente à crédit : l'Admin autorise la livraison sans
    // fabriquer un paiement Wave. Le crédit, la commande, l'événement d'audit
    // et l'entrée de file 9E sont écrits dans la même transaction.
    function isValidAdminCreditAuthorization(orderId) {
      let credit = getAfter(
        /databases/$(database)/documents/customerCredits/$(orderId)
      ).data;
      let queue = getAfter(
        /databases/$(database)/documents/autoAssignmentQueue/$(orderId)
      ).data;

      return isAdmin()
        && resource.data.status in ['awaitingPayment', 'paymentToVerify', 'expired']
        && !(resource.data.paymentStatus in ['confirmed', 'credit'])
        && request.resource.data.status == 'paidReady'
        && request.resource.data.paymentStatus == 'credit'
        && request.resource.data.get('paidAt', null) == resource.data.get('paidAt', null)
        && request.resource.data.get('paymentConfirmedAt', null)
          == resource.data.get('paymentConfirmedAt', null)
        && request.resource.data.get('paymentReference', null)
          == resource.data.get('paymentReference', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'paymentStatus',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.updatedAt == request.time
        && credit.orderId == orderId
        && credit.orderReference == resource.data.reference
        && credit.clientName == resource.data.clientName
        && credit.clientWhatsappPhone == resource.data.clientWhatsappPhone
        && credit.amount == resource.data.amount
        && credit.paidAmount == 0
        && credit.status == 'open'
        && credit.createdBy == request.auth.uid
        && credit.createdAt == request.time
        && queue.orderId == orderId
        && queue.orderReference == resource.data.reference
        && queue.network == resource.data.network
        && queue.amount == resource.data.amount
        && queue.createdAt == request.time
        && queue.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'CREDIT_AUTHORIZED');
    }

    function isAdminFailedOrderRequeueRequest() {
      return resource.data.status == 'failed'
        && request.resource.data.status == 'paidReady'
        && request.resource.data.get('lastEventType', null)
          == 'REASSIGNMENT_REQUESTED';
    }

    function isValidAdminFailedOrderRequeue(orderId) {
      // REAFFECTATION COMPAT V7 - validation locale uniquement.
      // Le document orderEvents/REASSIGNMENT_REQUESTED est valide par sa
      // propre regle a partir de l'etat AVANT de la commande. La mise a jour
      // orders ne relit donc plus l'evenement futur : aucune boucle getAfter.
      return orderId is string
        && orderId.size() >= 1
        && isAdmin()
        && resource.data.status == 'failed'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && request.resource.data.status == 'paidReady'
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignedAgentName', null) == null
        && request.resource.data.get('assignedByUserId', null) == null
        && request.resource.data.get('assignedAt', null) == null
        && request.resource.data.get('assignmentMode', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('manualAssignmentRequired', false) == true
        && request.resource.data.get('takenByUserId', null) == null
        && request.resource.data.get('takenAt', null) == null
        && request.resource.data.get('completedAt', null) == null
        && request.resource.data.get('failureReason', null) == null
        && request.resource.data.get('observation', null) == null
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []).size() == 0
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', '').size() >= 8
        && request.resource.data.get('lastEventId', '').size() <= 120
        && request.resource.data.get('lastEventType', null) == 'REASSIGNMENT_REQUESTED'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'takenByUserId',
          'takenAt',
          'completedAt',
          'failureReason',
          'observation',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastAssignmentRefusalReason',
          'lastAssignmentRefusedAt',
          'lastAssignmentRefusedAgentId',
          'autoAssignmentRefusedAgentIds',
          'manualAssignmentRequired',
          'lastHoldReason',
          'lastHeldAt',
          'lastResumedAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.updatedAt == request.time;
    }

    function isValidStaffOrderUpdate(orderId) {
      return isStaff()
        && hasValidCommonOrderValues()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && immutableCoreOrderFieldsAreUnchanged()
        && onlyStaffMutableFieldsChanged()
        && request.resource.data.updatedAt == request.time
        && (
          auditLinkIsUnchanged()
          || hasMatchingOrderEvent(
            orderId,
            request.resource.data.get('lastEventType', null)
          )
        );
    }


    function isValidStaffManualAssignmentFallback() {
      return isStaff()
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignedAgentId', null) == null
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && resource.data.get('manualAssignmentRequired', false) == false
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('manualAssignmentRequired', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'manualAssignmentRequired',
          'updatedAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && auditLinkIsUnchanged()
        && request.resource.data.updatedAt == request.time;
    }

    // Garde-fous sans lecture Firestore pour distinguer les deux
    // chemins d'affectation avant d'executer leurs validations couteuses.
    // Cela evite de consommer des get()/exists()/getAfter() du chemin manuel
    // pendant une affectation automatique (et inversement).
    function isManualAssignmentTransitionRequest() {
      return resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignmentMode', null) == 'manual';
    }

    function isAutomaticAssignmentTransitionRequest() {
      return resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignmentMode', null) == 'automatic';
    }

    function isValidAdminManualAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      let agentUserExists = exists(
        /databases/$(database)/documents/users/$(agentId)
      );
      let agentProfileExists = exists(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      );
      let agentUser = get(
        /databases/$(database)/documents/users/$(agentId)
      ).data;
      let agentProfile = get(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      ).data;
      let network = request.resource.data.network;
      let amount = request.resource.data.amount;

      // Affectation manuelle compatible avec le code Flutter deja installe.
      // La commande valide uniquement sa propre transition et l'agent cible.
      // orderAssignments et orderEvents valident chacun leur document sans
      // que /orders ait besoin de relire ces ecritures futures.
      return orderId is string
        && orderId.size() >= 1
        && agentId is string
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignedAgentId', null) == null
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == agentId
        && request.resource.data.get('assignedAgentName', null) is string
        && request.resource.data.get('assignedAgentName', '').size() >= 2
        && request.resource.data.get('assignedAgentName', '').size() <= 80
        && request.resource.data.get('assignedByUserId', null) == request.auth.uid
        && request.resource.data.get('assignedAt', null) == request.time
        && request.resource.data.get('assignmentMode', null) == 'manual'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('manualAssignmentRequired', false) == false
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', '').size() >= 8
        && request.resource.data.get('lastEventId', '').size() <= 120
        && request.resource.data.get('lastEventType', null) == 'ASSIGNED'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'manualAssignmentRequired',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        // Compatibilite commandes historiques : les champs modifiables sont deja
        // strictement limites par diff(). Certaines anciennes commandes peuvent ne
        // pas posseder tous les champs optionnels ajoutes dans les phases ulterieures.
        && request.resource.data.updatedAt == request.time
        && isAdmin()
        && agentUserExists
        && agentProfileExists
        && agentUser.role == 'agent'
        && agentUser.isActive == true
        && agentProfile.availability == 'available'
        && network in agentProfile.authorizedNetworks
        && network in agentProfile.activeNetworks
        && (
          (network == 'orange' && agentProfile.orangeCapacity >= amount)
          || (network == 'mtn' && agentProfile.mtnCapacity >= amount)
          || (network == 'moov' && agentProfile.moovCapacity >= amount)
        );
    }

    function automaticAssignmentTargetIsEligible(agentId) {
      let agentUser = get(
        /databases/$(database)/documents/users/$(agentId)
      ).data;
      let agentProfile = get(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      ).data;
      let network = request.resource.data.network;
      let amount = request.resource.data.amount;

      return agentUser.role == 'agent'
        && agentUser.isActive == true
        && agentProfile.availability == 'available'
        && network in agentProfile.authorizedNetworks
        && network in agentProfile.activeNetworks
        && (
          (network == 'orange' && agentProfile.orangeCapacity >= amount)
          || (network == 'mtn' && agentProfile.mtnCapacity >= amount)
          || (network == 'moov' && agentProfile.moovCapacity >= amount)
        );
    }

    // Validation 9E sans dependance circulaire : la commande est la seule
    // ecriture qui relit les artefacts futurs. Les regles orderAssignments et
    // orderEvents valident ensuite leur propre document sans relire orders.
    function hasMatchingAutomaticAssignmentArtifacts(orderId, agentId) {
      let eventId = request.resource.data.get('lastEventId', null);
      let event = getAfter(
        /databases/$(database)/documents/orderEvents/$(eventId)
      ).data;
      let assignmentId = event.metadata.get('assignmentId', null);
      let assignment = getAfter(
        /databases/$(database)/documents/orderAssignments/$(assignmentId)
      ).data;

      return eventId is string
        && event.orderId == orderId
        && event.orderReference == request.resource.data.reference
        && event.type == 'ASSIGNED'
        && event.actorId == request.auth.uid
        && event.createdAt == request.time
        && event.metadata is map
        && event.metadata.get('agentId', null) == agentId
        && assignmentId is string
        && assignment.orderId == orderId
        && assignment.orderReference == request.resource.data.reference
        && assignment.agentId == agentId
        && assignment.agentName == request.resource.data.get('assignedAgentName', '')
        && assignment.assignedByUserId == request.auth.uid
        && assignment.mode == 'automatic'
        && assignment.status == 'assigned'
        && assignment.assignedAt == request.time
        && assignment.updatedAt == request.time;
    }

    function hasValidAutomaticAssignmentTransition(orderId, agentId) {
      return agentId is string
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignedAgentId', null) == null
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && resource.data.get('manualAssignmentRequired', false) == false
        && resource.data.get('lastAssignmentRefusedAgentId', null) != agentId
        && !(agentId in resource.data.get('autoAssignmentRefusedAgentIds', []))
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == agentId
        && request.resource.data.get('assignedAgentName', null) is string
        && request.resource.data.get('assignedAgentName', '').size() >= 2
        && request.resource.data.get('assignedAgentName', '').size() <= 80
        && request.resource.data.get('assignedByUserId', null) == request.auth.uid
        && request.resource.data.get('assignedAt', null) == request.time
        && request.resource.data.get('assignmentMode', null) == 'automatic'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventType', null) == 'ASSIGNED'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.updatedAt == request.time
        && automaticAssignmentTargetIsEligible(agentId)
        && hasMatchingAutomaticAssignmentArtifacts(orderId, agentId);
    }

    function isValidStaffAutomaticAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      return agentId != request.auth.uid
        && isStaff()
        && hasValidAutomaticAssignmentTransition(orderId, agentId);
    }

    function isValidAgentAutomaticSelfAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      return agentId == request.auth.uid
        && isAgent()
        && hasValidAutomaticAssignmentTransition(orderId, agentId);
    }

    function isValidAgentAssignmentAcceptance(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignedAgentId', null) == request.auth.uid
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignmentStatus',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'ASSIGNMENT_ACCEPTED');
    }

    function isValidAgentAssignmentRefusal(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignedAgentName', null) == null
        && request.resource.data.get('assignedByUserId', null) == null
        && request.resource.data.get('assignedAt', null) == null
        && request.resource.data.get('assignmentMode', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('lastAssignmentRefusalReason', null) is string
        && request.resource.data.get('lastAssignmentRefusalReason', null).size() >= 3
        && request.resource.data.get('lastAssignmentRefusalReason', null).size() <= 500
        && request.resource.data.get('lastAssignmentRefusedAt', null) == request.time
        && request.resource.data.get('lastAssignmentRefusedAgentId', null) == request.auth.uid
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []) is list
        && request.resource.data.get('autoAssignmentRefusedAgentIds', []).hasAll(
          resource.data.get('autoAssignmentRefusedAgentIds', [])
        )
        && request.auth.uid in request.resource.data.get('autoAssignmentRefusedAgentIds', [])
        && (
          (
            request.auth.uid in resource.data.get('autoAssignmentRefusedAgentIds', [])
            && request.resource.data.get('autoAssignmentRefusedAgentIds', []).size()
              == resource.data.get('autoAssignmentRefusedAgentIds', []).size()
          )
          || (
            !(request.auth.uid in resource.data.get('autoAssignmentRefusedAgentIds', []))
            && request.resource.data.get('autoAssignmentRefusedAgentIds', []).size()
              == resource.data.get('autoAssignmentRefusedAgentIds', []).size() + 1
          )
        )
        && request.resource.data.get('manualAssignmentRequired', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastAssignmentRefusalReason',
          'lastAssignmentRefusedAt',
          'lastAssignmentRefusedAgentId',
          'autoAssignmentRefusedAgentIds',
          'manualAssignmentRequired',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'ASSIGNMENT_REFUSED');
    }

    function isValidAgentProcessingStart(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'paidReady'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && request.resource.data.get('assignedAgentId', null) == request.auth.uid
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.status == 'inProgress'
        && request.resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.get('takenAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'takenByUserId',
          'takenAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_STARTED');
    }

    function isValidAgentProcessingResume(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'onHold'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.status == 'inProgress'
        && request.resource.data.get('lastResumedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastResumedAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_RESUMED');
    }

    function isAgentHoldTransitionRequest() {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'onHold'
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.get('lastEventType', null) == 'PUT_ON_HOLD';
    }

    function isValidAgentProcessingHold() {
      // La mise en attente est volontairement validée sans lecture croisée future.
      // La transaction de l'application écrit toujours l'événement d'audit,
      // mais l'autorisation de la commande ne dépend plus d'une lecture croisée
      // du document orderEvents. Cela évite les permission-denied observés sur
      // certains appareils lors d'une transaction order + event.
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'inProgress'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && request.resource.data.status == 'onHold'
        && request.resource.data.get('lastHoldReason', null) is string
        && request.resource.data.get('lastHoldReason', null).size() >= 3
        && request.resource.data.get('lastHoldReason', null).size() <= 300
        && request.resource.data.get('lastHeldAt', null) == request.time
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', '').size() >= 8
        && request.resource.data.get('lastEventId', '').size() <= 120
        && request.resource.data.get('lastEventType', null) == 'PUT_ON_HOLD'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastHoldReason',
          'lastHeldAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidAgentProofForOrder(orderId) {
      let proof = get(
        /databases/$(database)/documents/orderProofs/$(orderId)
      ).data;

      return proof.get('agentId', null) == request.auth.uid
        && proof.get('orderId', null) == orderId;
    }

    function isValidAgentProcessingSuccess(orderId) {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'awaitingCustomerConfirmation'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && isCurrentAssignedAgent()
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && hasValidAgentProofForOrder(orderId)
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('failureReason', null) == null
        && request.resource.data.get('observation', null) == null
        && request.resource.data.get('customerConfirmationStatus', 'pending') == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'failureReason',
          'observation',
          'customerConfirmationStatus',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_SUCCEEDED');
    }

    function isValidAgentProcessingFailure(orderId) {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'failed'
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && isCurrentAssignedAgent()
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('failureReason', null) in [
          'incorrectNumber',
          'networkUnavailable',
          'offerUnavailable',
          'insufficientBalance',
          'technicalError',
          'incorrectPayment',
          'other'
        ]
        && (
          request.resource.data.get('observation', null) == null
          || (
            request.resource.data.get('observation', null) is string
            && request.resource.data.get('observation', null).size() <= 1000
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'failureReason',
          'observation',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_FAILED');
    }

    function isValidAgentProofAuditUpdate() {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status in ['inProgress', 'onHold']
        && paymentStatusAllowsProcessing(resource.data.paymentStatus)
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null)
          == resource.data.get('assignedAgentId', null)
        && request.resource.data.get('assignmentStatus', 'unassigned')
          == resource.data.get('assignmentStatus', 'unassigned')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', null).size() >= 8
        && request.resource.data.get('lastEventId', null).size() <= 120
        && request.resource.data.get('lastEventType', null) == 'PROOF_ADDED'
        && request.resource.data.get('lastEventAt', null) == request.time;
    }

    function isValidCustomerPaymentDeclaration(orderId) {
      let wasExpired = resource.data.status == 'expired';
      let isLate = request.time >= resource.data.expiresAt;
      let oldExpiredAt = resource.data.get('expiredAt', null);
      let newExpiredAt = request.resource.data.get('expiredAt', null);

      // Validation volontairement locale a cette transition.
      // Le diff ci-dessous interdit deja toute modification des champs
      // metier de la commande. On ne revalide donc pas tout le schema
      // historique via hasValidCommonOrderValues()/immutableCore..., ce qui
      // pouvait faire echouer une commande pourtant valide creee par la V3.
      return isSignedIn()
        && resource.data.get('customerAuthUid', null) == request.auth.uid
        && request.resource.data.get('customerAuthUid', null) == request.auth.uid
        && resource.data.source == 'customerWeb'
        && resource.data.status in ['awaitingPayment', 'expired']
        && resource.data.paymentStatus in ['notDeclared', 'expired']
        && resource.data.get('paymentDeclaredAt', null) == null

        // Seuls les champs de declaration + audit peuvent changer.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'paymentDeclaredAt',
          'paymentPayerName',
          'paymentPayerPhone',
          'paymentApproximateTime',
          'paymentDeclaredReference',
          'expiredAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])

        && request.resource.data.status == (
          wasExpired || isLate ? 'expired' : 'paymentToVerify'
        )
        && request.resource.data.paymentStatus == 'declared'
        && request.resource.data.paymentDeclaredAt == request.time

        && request.resource.data.paymentPayerName is string
        && request.resource.data.paymentPayerName.size() >= 2
        && request.resource.data.paymentPayerName.size() <= 80

        && request.resource.data.paymentPayerPhone is string
        && request.resource.data.paymentPayerPhone.matches(
          '^[+]225(01|05|07)[0-9]{8}$'
        )

        && request.resource.data.paymentApproximateTime is string
        && request.resource.data.paymentApproximateTime.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )

        && (
          request.resource.data.paymentDeclaredReference == null
          || (
            request.resource.data.paymentDeclaredReference is string
            && request.resource.data.paymentDeclaredReference.size() <= 80
          )
        )

        && (
          (!wasExpired && !isLate && newExpiredAt == oldExpiredAt)
          || (
            (wasExpired || isLate)
            && (
              (oldExpiredAt == null && newExpiredAt == request.time)
              || (oldExpiredAt != null && newExpiredAt == oldExpiredAt)
            )
          )
        )

        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', null).size() >= 8
        && request.resource.data.get('lastEventId', null).size() <= 120
        && request.resource.data.get('lastEventType', null) == 'PAYMENT_DECLARED'
        && request.resource.data.get('lastEventAt', null) == request.time

        // L'evenement PAYMENT_DECLARED doit toujours etre cree dans la meme
        // transaction. C'est la seule lecture getAfter() de cette transition.
        && hasMatchingOrderEvent(orderId, 'PAYMENT_DECLARED');
    }

    function isValidCustomerExpiration() {
      return isOrderOwner()
        && hasValidCommonOrderValues()
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'expiredAt'
        ])
        && resource.data.source == 'customerWeb'
        && resource.data.status in ['awaitingPayment', 'paymentToVerify']
        && resource.data.paymentStatus in [
          'notDeclared',
          'pending',
          'declared',
          'expired'
        ]
        && resource.data.paymentStatus != 'confirmed'
        && request.time >= resource.data.expiresAt
        && request.resource.data.status == 'expired'
        && request.resource.data.paymentStatus == (
          resource.data.paymentStatus == 'declared' ? 'declared' : 'expired'
        )
        && request.resource.data.expiredAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidPendingStaffProfileCreation(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'name',
          'email',
          'phoneNumber',
          'role',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber == ''
        && request.resource.data.role == 'pending'
        && request.resource.data.isActive == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOfferKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'network',
        'service',
        'operationType',
        'title',
        'catalogLabel',
        'description',
        'sellingPrice',
        'details',
        'badgeLabel',
        'category',
        'validity',
        'volume',
        'minutes',
        'sms',
        'eligibility',
        'isActive',
        'displayOrder',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidOfferValues() {
      return hasValidOfferKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data['service'] in [
          'internetSubscription',
          'calls'
        ]
        && request.resource.data.operationType in [
          'internetSubscription',
          'callBundle',
          'mixedBundle'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 100
        && request.resource.data.catalogLabel is string
        && request.resource.data.catalogLabel.size() >= 2
        && request.resource.data.catalogLabel.size() <= 200
        && (
          request.resource.data.description == null
          || request.resource.data.description is string
        )
        && request.resource.data.sellingPrice is int
        && request.resource.data.sellingPrice > 0
        && request.resource.data.sellingPrice <= 1000000
        && request.resource.data.details is list
        && (
          request.resource.data.badgeLabel == null
          || request.resource.data.badgeLabel is string
        )
        && request.resource.data.category in ['internet', 'calls', 'mixed']
        && (
          request.resource.data.validity == null
          || request.resource.data.validity is string
        )
        && (
          request.resource.data.volume == null
          || request.resource.data.volume is string
        )
        && (
          request.resource.data.minutes == null
          || request.resource.data.minutes is string
        )
        && (
          request.resource.data.sms == null
          || request.resource.data.sms is string
        )
        && (
          request.resource.data.eligibility == null
          || request.resource.data.eligibility is string
        )
        && request.resource.data.isActive is bool
        && request.resource.data.displayOrder is int
        && request.resource.data.displayOrder >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidOfferCreation() {
      return isAdmin() && hasValidOfferValues();
    }

    function isValidOfferUpdate() {
      return isAdmin()
        && hasValidOfferValues()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidAgentProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'userId',
        'agentCode',
        'availability',
        'zoneIds',
        'authorizedNetworks',
        'activeNetworks',
        'orangeCapacity',
        'mtnCapacity',
        'moovCapacity',
        'dailyTransactionLimit',
        'maxTransactionsPerDay',
        'lastCapacityUpdateAt',
        'lastOrangeMovementId',
        'lastMtnMovementId',
        'lastMoovMovementId',
        'lastSeenAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidAgentProfileValues(agentId) {
      return hasValidAgentProfileKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.userId == agentId
        && request.resource.data.agentCode is string
        && request.resource.data.agentCode.size() >= 3
        && request.resource.data.agentCode.size() <= 30
        && request.resource.data.availability in [
          'available',
          'unavailable'
        ]
        && request.resource.data.zoneIds is list
        && request.resource.data.zoneIds.size() <= 20
        && request.resource.data.authorizedNetworks is list
        && request.resource.data.authorizedNetworks.size() <= 3
        && request.resource.data.authorizedNetworks.hasOnly([
          'orange',
          'mtn',
          'moov'
        ])
        && request.resource.data.activeNetworks is list
        && request.resource.data.activeNetworks.size() <= 3
        && request.resource.data.activeNetworks.hasOnly([
          'orange',
          'mtn',
          'moov'
        ])
        && request.resource.data.activeNetworks.hasOnly(
          request.resource.data.authorizedNetworks
        )
        && request.resource.data.orangeCapacity is int
        && request.resource.data.orangeCapacity >= 0
        && request.resource.data.orangeCapacity <= 100000000
        && request.resource.data.mtnCapacity is int
        && request.resource.data.mtnCapacity >= 0
        && request.resource.data.mtnCapacity <= 100000000
        && request.resource.data.moovCapacity is int
        && request.resource.data.moovCapacity >= 0
        && request.resource.data.moovCapacity <= 100000000
        && request.resource.data.dailyTransactionLimit is int
        && request.resource.data.dailyTransactionLimit >= 0
        && request.resource.data.dailyTransactionLimit <= 100000000
        && request.resource.data.maxTransactionsPerDay is int
        && request.resource.data.maxTransactionsPerDay >= 0
        && request.resource.data.maxTransactionsPerDay <= 10000
        && (
          request.resource.data.lastCapacityUpdateAt == null
          || request.resource.data.lastCapacityUpdateAt is timestamp
        )
        && (
          request.resource.data.get('lastOrangeMovementId', null) == null
          || request.resource.data.get('lastOrangeMovementId', null) is string
        )
        && (
          request.resource.data.get('lastMtnMovementId', null) == null
          || request.resource.data.get('lastMtnMovementId', null) is string
        )
        && (
          request.resource.data.get('lastMoovMovementId', null) == null
          || request.resource.data.get('lastMoovMovementId', null) is string
        )
        && (
          request.resource.data.lastSeenAt == null
          || request.resource.data.lastSeenAt is timestamp
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function changedNetworkCapacityHasMovement(
      agentId,
      network,
      capacityBefore,
      capacityAfter,
      movementId
    ) {
      let movement = getAfter(
        /databases/$(database)/documents/networkTransactions/$(movementId)
      ).data;
      return movementId is string
        && movementId.size() >= 1
        && movement.agentId == agentId
        && movement.network == network
        && movement.capacityBefore == capacityBefore
        && movement.capacityAfter == capacityAfter
        && movement.amount > 0
        && movement.createdAt == request.time;
    }

    function networkCapacityChangeIsTraced(
      agentId,
      network,
      capacityBefore,
      capacityAfter,
      previousMovementId,
      nextMovementId
    ) {
      return (
          capacityBefore == capacityAfter
          && nextMovementId == previousMovementId
        ) || (
          capacityBefore != capacityAfter
          && nextMovementId != previousMovementId
          && changedNetworkCapacityHasMovement(
            agentId,
            network,
            capacityBefore,
            capacityAfter,
            nextMovementId
          )
        );
    }

    function allAgentCapacityChangesAreTraced(agentId) {
      let orangeChanged = request.resource.data.orangeCapacity
        != resource.data.orangeCapacity;
      let mtnChanged = request.resource.data.mtnCapacity
        != resource.data.mtnCapacity;
      let moovChanged = request.resource.data.moovCapacity
        != resource.data.moovCapacity;
      return networkCapacityChangeIsTraced(
          agentId,
          'orange',
          resource.data.orangeCapacity,
          request.resource.data.orangeCapacity,
          resource.data.get('lastOrangeMovementId', null),
          request.resource.data.get('lastOrangeMovementId', null)
        )
        && networkCapacityChangeIsTraced(
          agentId,
          'mtn',
          resource.data.mtnCapacity,
          request.resource.data.mtnCapacity,
          resource.data.get('lastMtnMovementId', null),
          request.resource.data.get('lastMtnMovementId', null)
        )
        && networkCapacityChangeIsTraced(
          agentId,
          'moov',
          resource.data.moovCapacity,
          request.resource.data.moovCapacity,
          resource.data.get('lastMoovMovementId', null),
          request.resource.data.get('lastMoovMovementId', null)
        )
        && (
          (
            !orangeChanged
            && !mtnChanged
            && !moovChanged
            && request.resource.data.get('lastCapacityUpdateAt', null)
              == resource.data.get('lastCapacityUpdateAt', null)
          ) || (
            (orangeChanged || mtnChanged || moovChanged)
            && request.resource.data.lastCapacityUpdateAt == request.time
          )
        );
    }

    function isValidAdminAgentProfileCreation(agentId) {
      return isAdmin()
        && getAfter(
          /databases/$(database)/documents/users/$(agentId)
        ).data.role == 'agent'
        && getAfter(
          /databases/$(database)/documents/users/$(agentId)
        ).data.isActive == true
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.orangeCapacity == 0
        && request.resource.data.mtnCapacity == 0
        && request.resource.data.moovCapacity == 0
        && request.resource.data.get('lastOrangeMovementId', null) == null
        && request.resource.data.get('lastMtnMovementId', null) == null
        && request.resource.data.get('lastMoovMovementId', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAdminAgentProfileUpdate(agentId) {
      return isAdmin()
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.agentCode == resource.data.agentCode
        && request.resource.data.createdAt == resource.data.createdAt
        && allAgentCapacityChangesAreTraced(agentId)
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentOperationalUpdate(agentId) {
      return isAgent()
        && request.auth.uid == agentId
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.agentCode == resource.data.agentCode
        && request.resource.data.zoneIds == resource.data.zoneIds
        && request.resource.data.authorizedNetworks == resource.data.authorizedNetworks
        && request.resource.data.dailyTransactionLimit == resource.data.dailyTransactionLimit
        && request.resource.data.maxTransactionsPerDay == resource.data.maxTransactionsPerDay
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availability',
          'activeNetworks',
          'orangeCapacity',
          'mtnCapacity',
          'moovCapacity',
          'lastCapacityUpdateAt',
          'lastOrangeMovementId',
          'lastMtnMovementId',
          'lastMoovMovementId',
          'lastSeenAt',
          'updatedAt'
        ])
        && allAgentCapacityChangesAreTraced(agentId)
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidZoneKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'name',
        'city',
        'region',
        'isActive',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidZoneValues() {
      return hasValidZoneKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() >= 2
        && request.resource.data.region.size() <= 100
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidZoneCreation() {
      return isAdmin()
        && hasValidZoneValues()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidZoneUpdate() {
      return isAdmin()
        && hasValidZoneValues()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidAgentIssueKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'agentId',
        'type',
        'network',
        'description',
        'status',
        'createdAt',
        'updatedAt',
        'resolvedAt',
        'resolvedBy'
      ]);
    }

    function hasValidAgentIssueValues() {
      return hasValidAgentIssueKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.agentId is string
        && request.resource.data.type in [
          'network',
          'balance',
          'technical',
          'other'
        ]
        && (
          request.resource.data.network == null
          || request.resource.data.network in ['orange', 'mtn', 'moov']
        )
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status in [
          'open',
          'acknowledged',
          'resolved',
          'cancelled'
        ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.resolvedAt == null
          || request.resource.data.resolvedAt is timestamp
        )
        && (
          request.resource.data.resolvedBy == null
          || request.resource.data.resolvedBy is string
        );
    }

    function isValidAgentIssueCreation() {
      return isAgent()
        && request.resource.data.agentId == request.auth.uid
        && hasValidAgentIssueValues()
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null;
    }

    function isValidAdminAgentIssueUpdate() {
      return isAdmin()
        && hasValidAgentIssueValues()
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidStaffUserValues() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'name',
        'email',
        'phoneNumber',
        'role',
        'isActive',
        'createdAt',
        'updatedAt'
      ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.role in [
          'pending',
          'operator',
          'supervisor',
          'agent',
          'admin'
        ]
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidAdminUserUpdate(userId) {
      return isAdmin()
        && hasValidStaffUserValues()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.auth.uid != userId
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive
          )
        );
    }


    function hasValidOrderAssignmentEventKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'agentId',
        'agentName',
        'assignedByUserId',
        'mode',
        'status',
        'assignedAt',
        'acceptedAt',
        'refusedAt',
        'refusalReason',
        'completedAt',
        'updatedAt'
      ]);
    }

    function isValidManualAssignmentEventCreation() {
      let orderId = request.resource.data.orderId;
      let agentId = request.resource.data.agentId;
      let orderBefore = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      // Validation unidirectionnelle sur l'etat AVANT affectation.
      // Le document /orders valide separement la transition vers l'agent.
      return request.resource.data.schemaVersion == 1
        && orderId is string
        && orderId.size() >= 1
        && agentId is string
        && agentId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.assignedByUserId == request.auth.uid
        && request.resource.data.mode == 'manual'
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.refusedAt == null
        && request.resource.data.refusalReason == null
        && request.resource.data.completedAt == null
        && request.resource.data.updatedAt == request.time
        && hasValidOrderAssignmentEventKeys()
        && isAdmin()
        && orderBefore.reference == request.resource.data.orderReference
        && orderBefore.status == 'paidReady'
        && paymentStatusAllowsProcessing(orderBefore.paymentStatus)
        && orderBefore.get('assignedAgentId', null) == null
        && orderBefore.get('assignmentStatus', 'unassigned') == 'unassigned';
    }

    function isValidAutomaticAssignmentEventCreation() {
      let agentId = request.resource.data.agentId;
      let isSelfAssignment = agentId == request.auth.uid;

      return request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && agentId is string
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.assignedByUserId == request.auth.uid
        && request.resource.data.mode == 'automatic'
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.refusedAt == null
        && request.resource.data.refusalReason == null
        && request.resource.data.completedAt == null
        && request.resource.data.updatedAt == request.time
        && hasValidOrderAssignmentEventKeys()
        && (
          (isSelfAssignment && isAgent())
          || (!isSelfAssignment && isStaff())
        );
    }

    function isValidAgentAssignmentEventAcceptance() {
      let orderId = resource.data.get('orderId', '');

      return isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && orderId is string
        && orderId.size() > 0
        && resource.data.get('status', '') == 'assigned'
        && resource.data.get('acceptedAt', null) == null
        && resource.data.get('refusedAt', null) == null
        && resource.data.get('refusalReason', null) == null
        && request.resource.data.get('status', '') == 'accepted'
        && request.resource.data.get('acceptedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'acceptedAt',
          'updatedAt'
        ])
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignedAgentId', null) == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignmentStatus', 'unassigned') == 'accepted'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventType', null) == 'ASSIGNMENT_ACCEPTED'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentAssignmentEventRefusal() {
      let orderId = resource.data.get('orderId', '');

      return isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && orderId is string
        && orderId.size() > 0
        && resource.data.get('status', '') == 'assigned'
        && resource.data.get('acceptedAt', null) == null
        && resource.data.get('refusedAt', null) == null
        && resource.data.get('refusalReason', null) == null
        && request.resource.data.get('status', '') == 'refused'
        && request.resource.data.get('acceptedAt', null) == null
        && request.resource.data.get('refusedAt', null) == request.time
        && request.resource.data.get('refusalReason', null) is string
        && request.resource.data.get('refusalReason', null).size() >= 3
        && request.resource.data.get('refusalReason', null).size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'refusedAt',
          'refusalReason',
          'updatedAt'
        ])
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignedAgentId', null) == null
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventType', null) == 'ASSIGNMENT_REFUSED'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentAssignmentEventCompletion() {
      let orderId = resource.data.get('orderId', '');
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return resource.data.get('status', '') == 'accepted'
        && resource.data.get('completedAt', null) == null
        && request.resource.data.get('status', '') == 'accepted'
        && request.resource.data.get('completedAt', null) == request.time
        && orderId is string
        && orderId.size() > 0
        && isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedAt',
          'updatedAt'
        ])
        && orderAfter.get('assignedAgentId', null) == request.auth.uid
        && orderAfter.get('assignmentStatus', 'unassigned') == 'accepted'
        && orderAfter.status in ['awaitingCustomerConfirmation', 'failed']
        && orderAfter.get('lastEventType', null) in [
          'PROCESSING_SUCCEEDED',
          'PROCESSING_FAILED'
        ]
        && orderAfter.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOrderProofKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'agentId',
        'fileName',
        'mimeType',
        'proofBytes',
        'sizeBytes',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidOrderProofValues(orderId) {
      return hasValidOrderProofKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 120
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.proofBytes is bytes
        && request.resource.data.proofBytes.size() > 0
        && request.resource.data.proofBytes.size() <= 750000
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes == request.resource.data.proofBytes.size()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function currentAgentCanWriteProof(orderId) {
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && paymentStatusAllowsProcessing(order.paymentStatus)
        && order.status in ['inProgress', 'onHold']
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference == order.reference
        && request.resource.data.agentId == request.auth.uid;
    }

    function isValidAgentOrderProofCreation(orderId) {
      return currentAgentCanWriteProof(orderId)
        && hasValidOrderProofValues(orderId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentOrderProofUpdate(orderId) {
      return currentAgentCanWriteProof(orderId)
        && hasValidOrderProofValues(orderId)
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.orderReference == resource.data.orderReference
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fileName',
          'mimeType',
          'proofBytes',
          'sizeBytes',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOrderEventKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'type',
        'actorId',
        'actorRole',
        'createdAt',
        'metadata'
      ]);
    }

    function hasValidOrderEventMetadata() {
      let metadata = request.resource.data.metadata;

      return metadata is map
        && metadata.keys().hasOnly([
          'source',
          'network',
          'amount',
          'paymentReference',
          'assignmentId',
          'agentId',
          'reason',
          'fileName',
          'sizeBytes',
          'failureReason',
          'observation',
          'messageSent',
          'releasedToQueue'
        ])
        && (
          metadata.get('source', null) == null
          || metadata.get('source', null) in ['customerWeb', 'operatorApp']
        )
        && (
          metadata.get('network', null) == null
          || metadata.get('network', null) in ['orange', 'mtn', 'moov']
        )
        && (
          metadata.get('amount', null) == null
          || metadata.get('amount', null) is int
        )
        && (
          metadata.get('paymentReference', null) == null
          || metadata.get('paymentReference', null) is string
        )
        && (
          metadata.get('assignmentId', null) == null
          || metadata.get('assignmentId', null) is string
        )
        && (
          metadata.get('agentId', null) == null
          || metadata.get('agentId', null) is string
        )
        && (
          metadata.get('reason', null) == null
          || (
            metadata.get('reason', null) is string
            && metadata.get('reason', null).size() <= 500
          )
        )
        && (
          metadata.get('fileName', null) == null
          || (
            metadata.get('fileName', null) is string
            && metadata.get('fileName', null).size() <= 120
          )
        )
        && (
          metadata.get('sizeBytes', null) == null
          || (
            metadata.get('sizeBytes', null) is int
            && metadata.get('sizeBytes', null) >= 0
            && metadata.get('sizeBytes', null) <= 750000
          )
        )
        && (
          metadata.get('failureReason', null) == null
          || metadata.get('failureReason', null) in [
            'incorrectNumber',
            'networkUnavailable',
            'offerUnavailable',
            'insufficientBalance',
            'technicalError',
            'incorrectPayment',
            'other'
          ]
        )
        && (
          metadata.get('observation', null) == null
          || (
            metadata.get('observation', null) is string
            && metadata.get('observation', null).size() <= 1000
          )
        )
        && (
          metadata.get('messageSent', null) == null
          || metadata.get('messageSent', null) is bool
        )
        && (
          metadata.get('releasedToQueue', null) == null
          || metadata.get('releasedToQueue', null) is bool
        );
    }

    function orderEventTypeIsValid() {
      return request.resource.data.type in [
        'ORDER_CREATED',
        'PAYMENT_DECLARED',
        'PAYMENT_CONFIRMED',
        'CREDIT_AUTHORIZED',
        'ASSIGNED',
        'ASSIGNMENT_ACCEPTED',
        'ASSIGNMENT_REFUSED',
        'PROCESSING_STARTED',
        'PUT_ON_HOLD',
        'PROCESSING_RESUMED',
        'PROOF_ADDED',
        'PROCESSING_SUCCEEDED',
        'PROCESSING_FAILED',
        'REASSIGNMENT_REQUESTED',
        'CUSTOMER_CONTACTED'
      ];
    }

    function orderEventActorIsValid() {
      let eventType = request.resource.data.type;
      let actorRole = request.resource.data.actorRole;

      return (
          actorRole == 'customer'
          && eventType in ['ORDER_CREATED', 'PAYMENT_DECLARED']
          && isSignedIn()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          actorRole == 'agent'
          && eventType in [
            'ASSIGNED',
            'ASSIGNMENT_ACCEPTED',
            'ASSIGNMENT_REFUSED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_RESUMED',
            'PROOF_ADDED',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED'
          ]
          && isAgent()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          // L'affectation manuelle est une action exclusivement Admin. Cette
          // branche évite de refaire isStaff + staffProfile + isAdmin pour le
          // même événement ASSIGNED.
          actorRole == 'admin'
          && eventType == 'ASSIGNED'
          && isAdmin()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          actorRole == 'admin'
          && eventType == 'CREDIT_AUTHORIZED'
          && isAdmin()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          actorRole in ['operator', 'supervisor', 'admin']
          && eventType in [
            'ORDER_CREATED',
            'PAYMENT_CONFIRMED',
            'ASSIGNED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED',
            'REASSIGNMENT_REQUESTED',
            'CUSTOMER_CONTACTED'
          ]
          && isStaff()
          && request.resource.data.actorId == request.auth.uid
          && actorRole == staffProfile().role
        );
    }

    function orderEventIsLinkedToOrder(eventId) {
      let orderId = request.resource.data.orderId;
      let order = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return order.reference == request.resource.data.orderReference
        && order.get('lastEventId', null) == eventId
        && order.get('lastEventType', null) == request.resource.data.type
        && order.get('lastEventAt', null) == request.time;
    }

    // ORDER_CREATED client : validation autonome, sans get/getAfter vers
    // orders. Le batch de l'application crée toujours orders + orderEvents,
    // mais chaque écriture peut désormais être autorisée indépendamment.
    function isValidCustomerOrderCreatedEvent() {
      let metadata = request.resource.data.metadata;

      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'type',
          'actorId',
          'actorRole',
          'createdAt',
          'metadata'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'ORDER_CREATED'
        && request.resource.data.actorRole == 'customer'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && metadata is map
        && metadata.keys().hasOnly([
          'source',
          'network',
          'amount'
        ])
        && metadata.source == 'customerWeb'
        && metadata.network in ['orange', 'mtn', 'moov']
        && metadata.amount is int
        && metadata.amount > 0
        && metadata.amount <= 1000000;
    }


    // PAYMENT_DECLARED client : la commande exige toujours l'evenement
    // correspondant via hasMatchingOrderEvent(). L'evenement, lui, valide
    // l'etat ACTUEL de la commande avec un simple get(), sans getAfter()
    // circulaire vers la mise a jour en cours.
    function isValidCustomerPaymentDeclaredEvent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isSignedIn()
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && orderId is string
        && orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'PAYMENT_DECLARED'
        && request.resource.data.actorRole == 'customer'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && hasValidOrderEventMetadata()
        && order.customerAuthUid == request.auth.uid
        && order.source == 'customerWeb'
        && order.reference == request.resource.data.orderReference
        && order.status in ['awaitingPayment', 'expired']
        && order.paymentStatus in ['notDeclared', 'expired'];
    }

    function isValidProofAddedEventForCurrentAgent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return request.resource.data.type == 'PROOF_ADDED'
        && request.resource.data.actorRole == 'agent'
        && request.resource.data.actorId == request.auth.uid
        && isAgent()
        && order.reference == request.resource.data.orderReference
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && paymentStatusAllowsProcessing(order.paymentStatus)
        && order.status in ['inProgress', 'onHold'];
    }

    // PUT_ON_HOLD est valide de maniere autonome a partir de l'etat courant
    // de la commande. La regle orders conserve le getAfter vers l'evenement,
    // mais l'evenement ne relit plus la commande mise a jour. Cela supprime la
    // dependance getAfter circulaire qui provoquait des permission-denied.
    function isValidAgentPutOnHoldEvent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;
      let reason = request.resource.data.metadata.get('reason', null);

      return hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && orderId is string
        && orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && hasValidOrderEventMetadata()
        && request.resource.data.type == 'PUT_ON_HOLD'
        && request.resource.data.actorRole == 'agent'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isAgent()
        && order.reference == request.resource.data.orderReference
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && paymentStatusAllowsProcessing(order.paymentStatus)
        && order.status == 'inProgress'
        && reason is string
        && reason.size() >= 3
        && reason.size() <= 300;
    }

    // REASSIGNMENT_REQUESTED est validé sur l'état AVANT réouverture de la
    // commande. La règle orders vérifie ensuite l'événement futur. La dépendance
    // reste donc unidirectionnelle et ne crée pas de boucle getAfter().
    function isValidAdminReassignmentRequestedEvent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;
      let reason = request.resource.data.metadata.get('reason', null);

      return isAdmin()
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && orderId is string
        && orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'REASSIGNMENT_REQUESTED'
        && request.resource.data.actorRole == 'admin'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && hasValidOrderEventMetadata()
        && order.reference == request.resource.data.orderReference
        && order.status == 'failed'
        && paymentStatusAllowsProcessing(order.paymentStatus)
        && reason is string
        && reason.size() >= 3
        && reason.size() <= 500;
    }

    // ASSIGNED est valide de maniere autonome. La liaison forte avec orders
    // et orderAssignments est verifiee depuis la regle de mise a jour orders,
    // ce qui supprime les getAfter circulaires responsables des refus 9E.
    function isValidAssignedOrderEventCreation() {
      let metadata = request.resource.data.metadata;
      let agentId = metadata.get('agentId', null);
      let isSelfAssignment = agentId == request.auth.uid;

      return isSignedIn()
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'ASSIGNED'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && metadata is map
        && metadata.keys().hasOnly([
          'assignmentId',
          'agentId'
        ])
        && metadata.get('assignmentId', null) is string
        && metadata.get('assignmentId', '').size() >= 1
        && agentId is string
        && agentId.size() >= 1
        && (
          (
            isSelfAssignment
            && request.resource.data.actorRole == 'agent'
            && isAgent()
          )
          || (
            !isSelfAssignment
            && request.resource.data.actorRole in [
              'operator',
              'supervisor',
              'admin'
            ]
            && isStaff()
            && request.resource.data.actorRole == staffProfile().role
          )
        );
    }

    function isValidOrderEventCreation(eventId) {
      return (
        request.resource.data.type == 'ORDER_CREATED'
        && request.resource.data.actorRole == 'customer'
        && isValidCustomerOrderCreatedEvent()
      ) || (
        request.resource.data.type == 'PAYMENT_DECLARED'
        && request.resource.data.actorRole == 'customer'
        && isValidCustomerPaymentDeclaredEvent()
      ) || (
        request.resource.data.type == 'ASSIGNED'
        && isValidAssignedOrderEventCreation()
      ) || (
        // ORDER_CREATED, PAYMENT_DECLARED et ASSIGNED ont leurs validations
        // dediees et ne retombent jamais dans la branche generique getAfter.
        !(request.resource.data.type in [
          'ORDER_CREATED',
          'PAYMENT_DECLARED',
          'ASSIGNED'
        ])
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && orderEventTypeIsValid()
        && request.resource.data.actorId is string
        && request.resource.data.actorId.size() >= 1
        && request.resource.data.actorRole in [
          'customer',
          'operator',
          'supervisor',
          'agent',
          'admin'
        ]
        && request.resource.data.createdAt == request.time
        && hasValidOrderEventMetadata()
        && (
          (
            request.resource.data.type == 'PROOF_ADDED'
            && isValidProofAddedEventForCurrentAgent()
          )
          || (
            request.resource.data.type == 'PUT_ON_HOLD'
            && isValidAgentPutOnHoldEvent()
          )
          || (
            !(request.resource.data.type in ['PROOF_ADDED', 'PUT_ON_HOLD'])
            && orderEventActorIsValid()
            && orderEventIsLinkedToOrder(eventId)
          )
        )
      );
    }

    function hasValidAutomaticQueueValues(orderId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'network',
          'amount',
          'createdAt',
          'updatedAt',
          'lastRefusedAgentId',
          'refusedAgentIds'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.lastRefusedAgentId == null
          || request.resource.data.lastRefusedAgentId is string
        )
        && request.resource.data.get('refusedAgentIds', []) is list
        && request.resource.data.get('refusedAgentIds', []).size() <= 100;
    }

    function isValidAgentQueueRecreationAfterRefusal(orderId) {
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && hasValidAutomaticQueueValues(orderId)
        && request.resource.data.lastRefusedAgentId == request.auth.uid
        && request.resource.data.get('refusedAgentIds', [])
          == orderAfter.get('autoAssignmentRefusedAgentIds', [])
        && request.auth.uid in request.resource.data.get('refusedAgentIds', [])
        && orderAfter.get('manualAssignmentRequired', false) == false
        && orderAfter.reference == request.resource.data.orderReference
        && orderAfter.network == request.resource.data.network
        && orderAfter.amount == request.resource.data.amount
        && orderAfter.status == 'paidReady'
        && paymentStatusAllowsProcessing(orderAfter.paymentStatus)
        && orderAfter.get('assignedAgentId', null) == null
        && orderAfter.get('assignmentStatus', 'unassigned') == 'unassigned'
        && orderAfter.get('lastAssignmentRefusedAgentId', null) == request.auth.uid
        && orderAfter.get('lastEventType', null) == 'ASSIGNMENT_REFUSED'
        && orderAfter.get('lastEventAt', null) == request.time;
    }

    function isValidAgentAutomaticQueueDelete(orderId) {
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && orderAfter.get('assignedAgentId', null) == request.auth.uid
        && orderAfter.get('assignedByUserId', null) == request.auth.uid
        && orderAfter.get('assignmentMode', null) == 'automatic'
        && orderAfter.get('assignmentStatus', 'unassigned') == 'assigned'
        && orderAfter.get('lastEventType', null) == 'ASSIGNED'
        && orderAfter.get('lastEventAt', null) == request.time;
    }

    // PHASE 10A - profil client regulier.
    // Le document a pour identifiant l'UID Firebase Anonymous du client.
    // Aucune regle 9E n'est modifiee et ce bloc n'ajoute aucune dependance croisee.
    function hasValidCustomerProfileValues(profileId) {
      return isSignedIn()
        && request.auth.uid == profileId
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'customerAuthUid',
          'name',
          'whatsappPhone',
          'defaultBeneficiaryPhone',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerAuthUid == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.whatsappPhone is string
        && request.resource.data.whatsappPhone.matches(
          '^[+]225(01|05|07)[0-9]{8}$'
        )
        && request.resource.data.defaultBeneficiaryPhone is string
        && request.resource.data.defaultBeneficiaryPhone.matches(
          '^[+]225(01|05|07)[0-9]{8}$'
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCustomerProfileCreation(profileId) {
      return hasValidCustomerProfileValues(profileId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidCustomerProfileUpdate(profileId) {
      return hasValidCustomerProfileValues(profileId)
        && resource.data.schemaVersion == 1
        && resource.data.customerAuthUid == request.auth.uid
        && resource.data.customerAuthUid == profileId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'whatsappPhone',
          'defaultBeneficiaryPhone',
          'updatedAt'
        ]);
    }

    match /customerProfiles/{profileId} {
      allow get: if isSignedIn() && request.auth.uid == profileId;
      allow list: if false;
      allow create: if isValidCustomerProfileCreation(profileId);
      allow update: if isValidCustomerProfileUpdate(profileId);
      allow delete: if false;
    }

    // PHASE 10B - recuperation securisee d'une commande depuis un autre appareil.
    // L'index n'est jamais listable. Le nouvel UID anonyme n'obtient qu'un
    // droit de lecture sur la commande exacte retrouvee.
    function hasRecoveredOrderAccess(orderId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/orderRecoveryAccess/$(orderId)/customers/$(request.auth.uid)
        );
    }

    function isValidOrderRecoveryKeyCreation(recoveryKey) {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'whatsappPhone',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 8
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.whatsappPhone is string
        && request.resource.data.whatsappPhone.matches(
          '^[+]225(01|05|07)[0-9]{8}$'
        )
        && request.resource.data.createdAt == request.time
        && recoveryKey
          == request.resource.data.orderReference + '_' + request.resource.data.whatsappPhone
        && order.customerAuthUid == request.auth.uid
        && order.reference == request.resource.data.orderReference
        && order.clientWhatsappPhone == request.resource.data.whatsappPhone;
    }

    function isValidRecoveredOrderAccessCreation(orderId, customerUid) {
      let recoveryKey = request.resource.data.recoveryKey;
      let recovery = get(
        /databases/$(database)/documents/orderRecoveryKeys/$(recoveryKey)
      ).data;

      return isSignedIn()
        && request.auth.uid == customerUid
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'customerAuthUid',
          'recoveryKey',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.customerAuthUid == customerUid
        && request.resource.data.recoveryKey is string
        && request.resource.data.recoveryKey.size() >= 20
        && request.resource.data.createdAt == request.time
        && recovery.orderId == orderId;
    }

    match /orderRecoveryKeys/{recoveryKey} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isValidOrderRecoveryKeyCreation(recoveryKey);
      allow update, delete: if false;
    }

    match /orderRecoveryAccess/{orderId}/customers/{customerUid} {
      allow get: if isSignedIn() && request.auth.uid == customerUid;
      allow list: if false;
      allow create: if isValidRecoveredOrderAccessCreation(orderId, customerUid);
      allow update, delete: if false;
    }

    // PHASE 10D - demande de verification client.
    // Une demande ne modifie jamais orders et ne cree aucun orderEvent.
    // Le proprietaire original OU un UID ayant recupere cette commande via
    // la Phase 10B peut creer une demande, uniquement pour cette commande.
    function customerCanRequestSupportForOrder(orderId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/orders/$(orderId)
        )
        && (
          get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.get('customerAuthUid', null) == request.auth.uid
          || exists(
            /databases/$(database)/documents/orderRecoveryAccess/$(orderId)/customers/$(request.auth.uid)
          )
        );
    }

    // PHASE 11C - les futures notifications/fermetures conservent aussi
    // l'identite de l'administrateur. Les anciens documents sans ces champs
    // restent lisibles et peuvent continuer leur cycle normalement.
    function hasValidSupportRequestValues() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'customerAuthUid',
          'type',
          'description',
          'status',
          'createdAt',
          'updatedAt',
          'assignedTo',
          'assignedToName',
          'inProgressAt',
          'resolutionNote',
          'resolvedAt',
          'resolvedBy',
          'resolvedByName',
          'customerNotifiedAt',
          'customerNotifiedBy',
          'customerNotifiedByName',
          'notificationChannel',
          'closedAt',
          'closedBy',
          'closedByName'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 8
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.orderReference.size() <= 40
        && request.resource.data.customerAuthUid is string
        && request.resource.data.type in [
          'paymentNotRecognized',
          'completedButNotReceived',
          'wrongAmount',
          'wrongNumber',
          'transactionFailed',
          'other'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && (
          request.resource.data.type != 'other'
          || request.resource.data.description.size() >= 3
        )
        && request.resource.data.status in [
          'new',
          'inProgress',
          'resolved',
          'closed'
        ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.get('assignedTo', null) == null
          || request.resource.data.get('assignedTo', null) is string
        )
        && (
          request.resource.data.get('assignedToName', null) == null
          || request.resource.data.get('assignedToName', null) is string
        )
        && (
          request.resource.data.get('inProgressAt', null) == null
          || request.resource.data.get('inProgressAt', null) is timestamp
        )
        && (
          request.resource.data.get('resolutionNote', null) == null
          || (
            request.resource.data.get('resolutionNote', null) is string
            && request.resource.data.get('resolutionNote', '').size() <= 1000
          )
        )
        && (
          request.resource.data.get('resolvedAt', null) == null
          || request.resource.data.get('resolvedAt', null) is timestamp
        )
        && (
          request.resource.data.get('resolvedBy', null) == null
          || request.resource.data.get('resolvedBy', null) is string
        )
        && (
          request.resource.data.get('resolvedByName', null) == null
          || request.resource.data.get('resolvedByName', null) is string
        )
        && (
          request.resource.data.get('customerNotifiedAt', null) == null
          || request.resource.data.get('customerNotifiedAt', null) is timestamp
        )
        && (
          request.resource.data.get('customerNotifiedBy', null) == null
          || request.resource.data.get('customerNotifiedBy', null) is string
        )
        && (
          request.resource.data.get('customerNotifiedByName', null) == null
          || request.resource.data.get('customerNotifiedByName', null) is string
        )
        && (
          request.resource.data.get('notificationChannel', null) == null
          || request.resource.data.get('notificationChannel', null) == 'whatsapp'
        )
        && (
          request.resource.data.get('closedAt', null) == null
          || request.resource.data.get('closedAt', null) is timestamp
        )
        && (
          request.resource.data.get('closedBy', null) == null
          || request.resource.data.get('closedBy', null) is string
        )
        && (
          request.resource.data.get('closedByName', null) == null
          || request.resource.data.get('closedByName', null) is string
        );
    }

    function isValidCustomerSupportRequestCreation() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return customerCanRequestSupportForOrder(orderId)
        && hasValidSupportRequestValues()
        && order.reference == request.resource.data.orderReference
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('assignedTo', null) == null
        && request.resource.data.get('assignedToName', null) == null
        && request.resource.data.get('inProgressAt', null) == null
        && request.resource.data.get('resolutionNote', null) == null
        && request.resource.data.get('resolvedAt', null) == null
        && request.resource.data.get('resolvedBy', null) == null
        && request.resource.data.get('resolvedByName', null) == null
        && request.resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.get('customerNotifiedBy', null) == null
        && request.resource.data.get('customerNotifiedByName', null) == null
        && request.resource.data.get('notificationChannel', null) == null
        && request.resource.data.get('closedAt', null) == null
        && request.resource.data.get('closedBy', null) == null
        && request.resource.data.get('closedByName', null) == null;
    }

    function supportRequestImmutableFieldsArePreserved() {
      return request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.orderReference == resource.data.orderReference
        && request.resource.data.customerAuthUid == resource.data.customerAuthUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidSupportRequestTakeInCharge() {
      return resource.data.status == 'new'
        && request.resource.data.status == 'inProgress'
        && request.resource.data.get('assignedTo', null) == request.auth.uid
        && request.resource.data.get('assignedToName', null) is string
        && request.resource.data.get('assignedToName', '').size() >= 2
        && request.resource.data.get('assignedToName', '').size() <= 80
        && request.resource.data.get('inProgressAt', null) == request.time
        && request.resource.data.get('resolutionNote', null) == null
        && request.resource.data.get('resolvedAt', null) == null
        && request.resource.data.get('resolvedBy', null) == null
        && request.resource.data.get('resolvedByName', null) == null
        && request.resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.get('customerNotifiedBy', null) == null
        && request.resource.data.get('customerNotifiedByName', null) == null
        && request.resource.data.get('notificationChannel', null) == null
        && request.resource.data.get('closedAt', null) == null
        && request.resource.data.get('closedBy', null) == null
        && request.resource.data.get('closedByName', null) == null;
    }

    function isValidSupportRequestResolution() {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'resolved'
        && request.resource.data.get('assignedTo', null)
          == resource.data.get('assignedTo', null)
        && request.resource.data.get('assignedToName', null)
          == resource.data.get('assignedToName', null)
        && request.resource.data.get('inProgressAt', null)
          == resource.data.get('inProgressAt', null)
        && request.resource.data.get('resolutionNote', null) is string
        && request.resource.data.get('resolutionNote', '').size() >= 3
        && request.resource.data.get('resolutionNote', '').size() <= 1000
        && request.resource.data.get('resolvedAt', null) == request.time
        && request.resource.data.get('resolvedBy', null) == request.auth.uid
        && request.resource.data.get('resolvedByName', null) is string
        && request.resource.data.get('resolvedByName', '').size() >= 2
        && request.resource.data.get('resolvedByName', '').size() <= 80
        && request.resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.get('customerNotifiedBy', null) == null
        && request.resource.data.get('customerNotifiedByName', null) == null
        && request.resource.data.get('notificationChannel', null) == null
        && request.resource.data.get('closedAt', null) == null
        && request.resource.data.get('closedBy', null) == null
        && request.resource.data.get('closedByName', null) == null;
    }

    function isValidSupportRequestCustomerNotification() {
      return resource.data.status == 'resolved'
        && request.resource.data.status == 'resolved'
        && request.resource.data.get('assignedTo', null)
          == resource.data.get('assignedTo', null)
        && request.resource.data.get('assignedToName', null)
          == resource.data.get('assignedToName', null)
        && request.resource.data.get('inProgressAt', null)
          == resource.data.get('inProgressAt', null)
        && request.resource.data.get('resolutionNote', null)
          == resource.data.get('resolutionNote', null)
        && request.resource.data.get('resolvedAt', null)
          == resource.data.get('resolvedAt', null)
        && request.resource.data.get('resolvedBy', null)
          == resource.data.get('resolvedBy', null)
        && request.resource.data.get('resolvedByName', null)
          == resource.data.get('resolvedByName', null)
        && resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.get('customerNotifiedAt', null) == request.time
        && request.resource.data.get('customerNotifiedBy', null) == request.auth.uid
        && request.resource.data.get('customerNotifiedByName', null) is string
        && request.resource.data.get('customerNotifiedByName', '').size() >= 2
        && request.resource.data.get('customerNotifiedByName', '').size() <= 80
        && request.resource.data.get('notificationChannel', null) == 'whatsapp'
        && request.resource.data.get('closedAt', null) == null
        && request.resource.data.get('closedBy', null) == null
        && request.resource.data.get('closedByName', null) == null;
    }

    function isValidSupportRequestClosure() {
      return resource.data.status == 'resolved'
        && request.resource.data.status == 'closed'
        && request.resource.data.get('assignedTo', null)
          == resource.data.get('assignedTo', null)
        && request.resource.data.get('assignedToName', null)
          == resource.data.get('assignedToName', null)
        && request.resource.data.get('inProgressAt', null)
          == resource.data.get('inProgressAt', null)
        && request.resource.data.get('resolutionNote', null)
          == resource.data.get('resolutionNote', null)
        && request.resource.data.get('resolvedAt', null)
          == resource.data.get('resolvedAt', null)
        && request.resource.data.get('resolvedBy', null)
          == resource.data.get('resolvedBy', null)
        && request.resource.data.get('resolvedByName', null)
          == resource.data.get('resolvedByName', null)
        && request.resource.data.get('customerNotifiedAt', null)
          == resource.data.get('customerNotifiedAt', null)
        && request.resource.data.get('customerNotifiedBy', null)
          == resource.data.get('customerNotifiedBy', null)
        && request.resource.data.get('customerNotifiedByName', null)
          == resource.data.get('customerNotifiedByName', null)
        && request.resource.data.get('notificationChannel', null)
          == resource.data.get('notificationChannel', null)
        && request.resource.data.get('closedAt', null) == request.time
        && request.resource.data.get('closedBy', null) == request.auth.uid
        && request.resource.data.get('closedByName', null) is string
        && request.resource.data.get('closedByName', '').size() >= 2
        && request.resource.data.get('closedByName', '').size() <= 80;
    }

    function isValidAdminSupportRequestUpdate() {
      return isAdmin()
        && hasValidSupportRequestValues()
        && supportRequestImmutableFieldsArePreserved()
        && request.resource.data.updatedAt == request.time
        && (
          isValidSupportRequestTakeInCharge()
          || isValidSupportRequestResolution()
          || isValidSupportRequestCustomerNotification()
          || isValidSupportRequestClosure()
        );
    }

    function hasValidRefundValues() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'supportRequestId',
          'supportRequestType',
          'supportRequestDescription',
          'customerAuthUid',
          'clientName',
          'clientWhatsappPhone',
          'originalAmount',
          'amount',
          'reason',
          'reasonNote',
          'paymentChannel',
          'originalPaymentReference',
          'status',
          'requestedAt',
          'requestedBy',
          'requestedByName',
          'approvedAt',
          'approvedBy',
          'approvedByName',
          'rejectedAt',
          'rejectedBy',
          'rejectedByName',
          'rejectionReason',
          'refundReference',
          'refundedAt',
          'refundedBy',
          'refundedByName',
          'customerNotifiedAt',
          'customerNotifiedBy',
          'customerNotifiedByName',
          'notificationChannel',
          'reconciledAt',
          'reconciledBy',
          'reconciledByName',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 8
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.orderReference.size() <= 40
        && request.resource.data.supportRequestId is string
        && request.resource.data.supportRequestId.size() >= 8
        && request.resource.data.supportRequestType in [
          'paymentNotRecognized',
          'completedButNotReceived',
          'wrongAmount',
          'wrongNumber',
          'transactionFailed',
          'other'
        ]
        && request.resource.data.supportRequestDescription is string
        && request.resource.data.supportRequestDescription.size() <= 1000
        && (
          request.resource.data.get('customerAuthUid', null) == null
          || request.resource.data.get('customerAuthUid', null) is string
        )
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientWhatsappPhone is string
        && request.resource.data.originalAmount is int
        && request.resource.data.originalAmount > 0
        && request.resource.data.originalAmount <= 1000000
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= request.resource.data.originalAmount
        && request.resource.data.reason in [
          'serviceNotReceived',
          'transactionFailed',
          'wrongAmount',
          'wrongNumber',
          'duplicatePayment',
          'cancellation',
          'paymentIssue',
          'other'
        ]
        && request.resource.data.reasonNote is string
        && request.resource.data.reasonNote.size() <= 500
        && (
          request.resource.data.reason != 'other'
          || request.resource.data.reasonNote.size() >= 3
        )
        && request.resource.data.paymentChannel == 'wave'
        && (
          request.resource.data.get('originalPaymentReference', null) == null
          || (
            request.resource.data.get('originalPaymentReference', null) is string
            && request.resource.data.get('originalPaymentReference', '').size() <= 120
          )
        )
        && request.resource.data.status in [
          'pendingApproval',
          'approved',
          'refunded',
          'reconciled',
          'rejected'
        ]
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.requestedBy is string
        && request.resource.data.requestedByName is string
        && request.resource.data.requestedByName.size() >= 2
        && request.resource.data.requestedByName.size() <= 80
        && (
          request.resource.data.get('approvedAt', null) == null
          || request.resource.data.get('approvedAt', null) is timestamp
        )
        && (
          request.resource.data.get('approvedBy', null) == null
          || request.resource.data.get('approvedBy', null) is string
        )
        && (
          request.resource.data.get('approvedByName', null) == null
          || request.resource.data.get('approvedByName', null) is string
        )
        && (
          request.resource.data.get('rejectedAt', null) == null
          || request.resource.data.get('rejectedAt', null) is timestamp
        )
        && (
          request.resource.data.get('rejectedBy', null) == null
          || request.resource.data.get('rejectedBy', null) is string
        )
        && (
          request.resource.data.get('rejectedByName', null) == null
          || request.resource.data.get('rejectedByName', null) is string
        )
        && (
          request.resource.data.get('rejectionReason', null) == null
          || (
            request.resource.data.get('rejectionReason', null) is string
            && request.resource.data.get('rejectionReason', '').size() >= 3
            && request.resource.data.get('rejectionReason', '').size() <= 500
          )
        )
        && (
          request.resource.data.get('refundReference', null) == null
          || (
            request.resource.data.get('refundReference', null) is string
            && request.resource.data.get('refundReference', '').size() >= 3
            && request.resource.data.get('refundReference', '').size() <= 120
          )
        )
        && (
          request.resource.data.get('refundedAt', null) == null
          || request.resource.data.get('refundedAt', null) is timestamp
        )
        && (
          request.resource.data.get('refundedBy', null) == null
          || request.resource.data.get('refundedBy', null) is string
        )
        && (
          request.resource.data.get('refundedByName', null) == null
          || request.resource.data.get('refundedByName', null) is string
        )
        && (
          request.resource.data.get('customerNotifiedAt', null) == null
          || request.resource.data.get('customerNotifiedAt', null) is timestamp
        )
        && (
          request.resource.data.get('customerNotifiedBy', null) == null
          || request.resource.data.get('customerNotifiedBy', null) is string
        )
        && (
          request.resource.data.get('customerNotifiedByName', null) == null
          || request.resource.data.get('customerNotifiedByName', null) is string
        )
        && (
          request.resource.data.get('notificationChannel', null) == null
          || request.resource.data.get('notificationChannel', null) == 'whatsapp'
        )
        && (
          request.resource.data.get('reconciledAt', null) == null
          || request.resource.data.get('reconciledAt', null) is timestamp
        )
        && (
          request.resource.data.get('reconciledBy', null) == null
          || request.resource.data.get('reconciledBy', null) is string
        )
        && (
          request.resource.data.get('reconciledByName', null) == null
          || request.resource.data.get('reconciledByName', null) is string
        )
        && request.resource.data.updatedAt is timestamp;
    }

    // PHASE 11B FIX V2 - création de remboursement.
    // Les champs dupliqués servant uniquement à l'affichage (nom client,
    // WhatsApp, description de la demande, référence de paiement) ne doivent
    // pas rendre la création impossible à cause d'une normalisation locale
    // (trim, casse, ancienne donnée). La sécurité repose sur les documents
    // canoniques orders + supportRequests, le montant, l'UID client et le rôle
    // Admin. Un seul remboursement reste garanti par refunds/{orderId}.
    function isValidAdminRefundCreation(refundId) {
      let orderId = request.resource.data.orderId;
      let supportId = request.resource.data.supportRequestId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let supportPath = /databases/$(database)/documents/supportRequests/$(supportId);

      return isAdmin()
        && refundId == orderId
        && exists(orderPath)
        && hasValidRefundValues()
        && get(orderPath).data.paymentStatus == 'confirmed'
        && get(orderPath).data.reference == request.resource.data.orderReference
        && get(orderPath).data.amount == request.resource.data.originalAmount
        && (
          (
            exists(supportPath)
            && get(supportPath).data.orderId == orderId
            && get(supportPath).data.orderReference == get(orderPath).data.reference
            && get(supportPath).data.customerAuthUid
              == request.resource.data.get('customerAuthUid', null)
            && get(supportPath).data.status in ['inProgress', 'resolved']
          ) || (
            supportId == 'failed_' + orderId
            && get(orderPath).data.status == 'failed'
            && request.resource.data.supportRequestType == 'transactionFailed'
          )
        )
        && request.resource.data.status == 'pendingApproval'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('approvedAt', null) == null
        && request.resource.data.get('approvedBy', null) == null
        && request.resource.data.get('approvedByName', null) == null
        && request.resource.data.get('rejectedAt', null) == null
        && request.resource.data.get('rejectedBy', null) == null
        && request.resource.data.get('rejectedByName', null) == null
        && request.resource.data.get('rejectionReason', null) == null
        && request.resource.data.get('refundReference', null) == null
        && request.resource.data.get('refundedAt', null) == null
        && request.resource.data.get('refundedBy', null) == null
        && request.resource.data.get('refundedByName', null) == null
        && request.resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.get('customerNotifiedBy', null) == null
        && request.resource.data.get('customerNotifiedByName', null) == null
        && request.resource.data.get('notificationChannel', null) == null
        && request.resource.data.get('reconciledAt', null) == null
        && request.resource.data.get('reconciledBy', null) == null
        && request.resource.data.get('reconciledByName', null) == null;
    }

    function isValidRefundApproval() {
      return resource.data.status == 'pendingApproval'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedAt',
          'approvedBy',
          'approvedByName',
          'updatedAt'
        ])
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedByName is string
        && request.resource.data.approvedByName.size() >= 2
        && request.resource.data.approvedByName.size() <= 80;
    }

    function isValidRefundRejection() {
      return resource.data.status == 'pendingApproval'
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'rejectedAt',
          'rejectedBy',
          'rejectedByName',
          'rejectionReason',
          'updatedAt'
        ])
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.rejectedByName is string
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() >= 3
        && request.resource.data.rejectionReason.size() <= 500;
    }

    function isValidRefundCompletion() {
      return resource.data.status == 'approved'
        && request.resource.data.status == 'refunded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'refundReference',
          'refundedAt',
          'refundedBy',
          'refundedByName',
          'updatedAt'
        ])
        && request.resource.data.refundReference is string
        && request.resource.data.refundReference.size() >= 3
        && request.resource.data.refundReference.size() <= 120
        && request.resource.data.refundedAt == request.time
        && request.resource.data.refundedBy == request.auth.uid
        && request.resource.data.refundedByName is string
        && request.resource.data.refundedByName.size() >= 2
        && request.resource.data.refundedByName.size() <= 80;
    }

    function isValidRefundCustomerNotification() {
      return resource.data.status in ['refunded', 'reconciled']
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerNotifiedAt',
          'customerNotifiedBy',
          'customerNotifiedByName',
          'notificationChannel',
          'updatedAt'
        ])
        && resource.data.get('customerNotifiedAt', null) == null
        && request.resource.data.customerNotifiedAt == request.time
        && request.resource.data.customerNotifiedBy == request.auth.uid
        && request.resource.data.customerNotifiedByName is string
        && request.resource.data.customerNotifiedByName.size() >= 2
        && request.resource.data.customerNotifiedByName.size() <= 80
        && request.resource.data.notificationChannel == 'whatsapp';
    }

    function isValidRefundReconciliation() {
      return resource.data.status == 'refunded'
        && request.resource.data.status == 'reconciled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reconciledAt',
          'reconciledBy',
          'reconciledByName',
          'updatedAt'
        ])
        && request.resource.data.reconciledAt == request.time
        && request.resource.data.reconciledBy == request.auth.uid
        && request.resource.data.reconciledByName is string
        && request.resource.data.reconciledByName.size() >= 2
        && request.resource.data.reconciledByName.size() <= 80;
    }

    // PHASE 11B FIX V3 - transitions de remboursement.
    // Chaque transition valide deja strictement la liste des champs modifies
    // avec diff(...).affectedKeys().hasOnly(...). Il est donc inutile et
    // fragile de revalider tout le document historique via
    // hasValidRefundValues() a chaque update. Les champs hors transition sont
    // automatiquement immuables puisqu'ils ne peuvent pas apparaitre dans le
    // diff autorise. Cette validation locale evite les permission-denied dus
    // a une ancienne valeur optionnelle tout en gardant les transitions
    // strictement bornees.
    function isValidAdminRefundUpdate() {
      return isAdmin()
        && request.resource.data.updatedAt == request.time
        && (
          isValidRefundApproval()
          || isValidRefundRejection()
          || isValidRefundCompletion()
          || isValidRefundCustomerNotification()
          || isValidRefundReconciliation()
        );
    }

    // PHASE 12 - commissions et performances agents.
    // Une commission est créée une seule fois, dans la même transaction que
    // PROCESSING_SUCCEEDED. Le compte agrégé de l'agent est mis à jour dans
    // la même transaction. Les dépendances ajoutées restent unidirectionnelles :
    // commission -> order, commissionAccount -> commission et
    // commissionAccount -> commissionPayout. Aucun artefact ne relit le compte.
    function hasValidCommissionValues(commissionId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'agentId',
          'agentName',
          'network',
          'orderAmount',
          'commissionAmount',
          'policyId',
          'policyType',
          'rate',
          'processingStartedAt',
          'earnedAt',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == commissionId
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 8
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.orderReference.size() <= 40
        && request.resource.data.agentId is string
        && request.resource.data.agentId.size() >= 1
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.orderAmount is int
        && request.resource.data.orderAmount > 0
        && request.resource.data.orderAmount <= 1000000
        && request.resource.data.commissionAmount == 10
        && request.resource.data.policyId == 'fixed-10-v1'
        && request.resource.data.policyType == 'fixedPerSuccessfulTransaction'
        && request.resource.data.rate == 10
        && (
          request.resource.data.processingStartedAt == null
          || request.resource.data.processingStartedAt is timestamp
        )
        && request.resource.data.earnedAt == request.time
        && request.resource.data.createdAt == request.time;
    }

    function isValidAgentCommissionCreation(commissionId) {
      let order = getAfter(
        /databases/$(database)/documents/orders/$(commissionId)
      ).data;

      return isAgent()
        && request.resource.data.agentId == request.auth.uid
        && hasValidCommissionValues(commissionId)
        && order.reference == request.resource.data.orderReference
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignedAgentName', null) == request.resource.data.agentName
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && paymentStatusAllowsProcessing(order.paymentStatus)
        && order.status == 'awaitingCustomerConfirmation'
        && order.amount == request.resource.data.orderAmount
        && order.network == request.resource.data.network
        && order.get('takenAt', null)
          == request.resource.data.get('processingStartedAt', null)
        && order.get('completedAt', null) == request.time
        && order.get('lastEventType', null) == 'PROCESSING_SUCCEEDED'
        && order.get('lastEventAt', null) == request.time;
    }

    function hasValidCommissionAccountValues(accountId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'agentId',
          'agentName',
          'earnedTotal',
          'paidTotal',
          'earnedTransactions',
          'lastCommissionOrderId',
          'lastPayoutId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.agentId == accountId
        && request.resource.data.agentId is string
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.earnedTotal is int
        && request.resource.data.earnedTotal >= 0
        && request.resource.data.paidTotal is int
        && request.resource.data.paidTotal >= 0
        && request.resource.data.paidTotal <= request.resource.data.earnedTotal
        && request.resource.data.earnedTransactions is int
        && request.resource.data.earnedTransactions >= 0
        && (
          request.resource.data.get('lastCommissionOrderId', null) == null
          || request.resource.data.get('lastCommissionOrderId', null) is string
        )
        && (
          request.resource.data.get('lastPayoutId', null) == null
          || request.resource.data.get('lastPayoutId', null) is string
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function commissionForAccountRequest() {
      let commissionId = request.resource.data.get('lastCommissionOrderId', '');
      return getAfter(
        /databases/$(database)/documents/commissions/$(commissionId)
      ).data;
    }

    function commissionMatchesAccountRequest(accountId, commission) {
      let commissionId = request.resource.data.get('lastCommissionOrderId', '');

      return commissionId is string
        && commissionId.size() >= 8
        && commission.orderId == commissionId
        && commission.agentId == accountId
        && commission.agentName == request.resource.data.agentName
        && commission.commissionAmount is int
        && commission.commissionAmount > 0
        && commission.earnedAt == request.time;
    }

    function isValidAgentCommissionAccountCreation(accountId) {
      let commission = commissionForAccountRequest();

      return isAgent()
        && request.auth.uid == accountId
        && hasValidCommissionAccountValues(accountId)
        && commissionMatchesAccountRequest(accountId, commission)
        && request.resource.data.earnedTotal == commission.commissionAmount
        && request.resource.data.paidTotal == 0
        && request.resource.data.earnedTransactions == 1
        && request.resource.data.get('lastPayoutId', null) == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentCommissionAccountUpdate(accountId) {
      let commission = commissionForAccountRequest();

      return isAgent()
        && request.auth.uid == accountId
        && hasValidCommissionAccountValues(accountId)
        && commissionMatchesAccountRequest(accountId, commission)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.paidTotal == resource.data.paidTotal
        && request.resource.data.get('lastPayoutId', null)
          == resource.data.get('lastPayoutId', null)
        && request.resource.data.earnedTotal
          == resource.data.earnedTotal + commission.commissionAmount
        && request.resource.data.earnedTransactions
          == resource.data.earnedTransactions + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'agentName',
          'earnedTotal',
          'earnedTransactions',
          'lastCommissionOrderId',
          'updatedAt'
        ]);
    }

    // PHASE 13 - règles financières compactes pour rester sous les limites
    // de compilation Firebase Rules. Les écritures sensibles restent réservées
    // à l'Admin et les journaux financiers restent immuables.

    function hasValidNetworkTransactionValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.direction in ['incoming', 'outgoing']
        && request.resource.data.type in ['orderSuccess', 'supplierRecharge', 'manualAdjustment']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.capacityBefore is int
        && request.resource.data.capacityBefore >= 0
        && request.resource.data.capacityAfter is int
        && request.resource.data.capacityAfter >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByRole in ['agent', 'admin']
        && request.resource.data.createdAt == request.time;
    }

    function isValidAgentOrderNetworkTransactionCreation(transactionId) {
      let orderId = request.resource.data.orderId;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      return isAgent()
        && hasValidNetworkTransactionValues()
        && request.resource.data.type == 'orderSuccess'
        && request.resource.data.direction == 'outgoing'
        && transactionId == 'order_' + orderId
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.createdByRole == 'agent'
        && request.resource.data.capacityAfter
          == request.resource.data.capacityBefore - request.resource.data.amount
        && order.reference == request.resource.data.orderReference
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.status == 'awaitingCustomerConfirmation'
        && order.amount == request.resource.data.amount
        && order.network == request.resource.data.network
        && order.get('completedAt', null) == request.time;
    }

    function isValidManualNetworkAdjustmentCreation() {
      let agentId = request.resource.data.agentId;
      let before = get(/databases/$(database)/documents/agentProfiles/$(agentId)).data;
      let network = request.resource.data.network;
      let beforeMatches =
        (network == 'orange' && before.orangeCapacity == request.resource.data.capacityBefore)
        || (network == 'mtn' && before.mtnCapacity == request.resource.data.capacityBefore)
        || (network == 'moov' && before.moovCapacity == request.resource.data.capacityBefore);
      return (isAdmin() || (isAgent() && agentId == request.auth.uid))
        && hasValidNetworkTransactionValues()
        && request.resource.data.type == 'manualAdjustment'
        && beforeMatches
        && (
          (isAdmin() && request.resource.data.createdByRole == 'admin')
          || (isAgent() && request.resource.data.createdByRole == 'agent')
        )
        && (
          (request.resource.data.direction == 'incoming'
            && request.resource.data.capacityAfter > request.resource.data.capacityBefore
            && request.resource.data.amount
              == request.resource.data.capacityAfter - request.resource.data.capacityBefore)
          ||
          (request.resource.data.direction == 'outgoing'
            && request.resource.data.capacityAfter < request.resource.data.capacityBefore
            && request.resource.data.amount
              == request.resource.data.capacityBefore - request.resource.data.capacityAfter)
        );
    }

    function financeAmount(value) {
      return value is int && value >= 0 && value <= 100000000;
    }

    function positiveFinanceAmount(value) {
      return value is int && value > 0 && value <= 100000000;
    }

    function validFinancePaymentChannel(value) {
      return value in ['wave', 'cash', 'bank', 'other'];
    }

    function hasValidFinanceSupplierValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string;
    }

    function isValidFinanceSupplierCreation() {
      return isAdmin()
        && hasValidFinanceSupplierValues()
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidFinanceSupplierUpdate() {
      return isAdmin()
        && hasValidFinanceSupplierValues()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name == resource.data.name
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isActive', 'updatedAt', 'updatedBy', 'updatedByName'
        ]);
    }

    function hasValidSupplierRechargeValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.supplierId is string
        && request.resource.data.agentId is string
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && positiveFinanceAmount(request.resource.data.principalAmount)
        && financeAmount(request.resource.data.bonusAmount)
        && request.resource.data.receivedAmount
          == request.resource.data.principalAmount + request.resource.data.bonusAmount
        && request.resource.data.amountOwed == request.resource.data.principalAmount
        && request.resource.data.capacityBefore is int
        && request.resource.data.capacityBefore >= 0
        && request.resource.data.capacityAfter
          == request.resource.data.capacityBefore + request.resource.data.receivedAmount
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidSupplierRechargeCreation() {
      let supplier = get(/databases/$(database)/documents/financeSuppliers/$(request.resource.data.supplierId)).data;
      let agent = get(/databases/$(database)/documents/agentProfiles/$(request.resource.data.agentId)).data;
      return isAdmin()
        && hasValidSupplierRechargeValues()
        && supplier.isActive == true
        && supplier.name == request.resource.data.supplierName
        && agent.userId == request.resource.data.agentId
        && request.resource.data.network in agent.authorizedNetworks;
    }

    function hasValidSupplierAccountValues(accountId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.supplierId == accountId
        && financeAmount(request.resource.data.totalOwed)
        && financeAmount(request.resource.data.totalPaid)
        && request.resource.data.totalPaid <= request.resource.data.totalOwed
        && financeAmount(request.resource.data.totalRecharged)
        && request.resource.data.rechargeCount is int
        && request.resource.data.rechargeCount >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidSupplierAccountCreation(accountId) {
      let rechargeId = request.resource.data.lastRechargeId;
      let recharge = getAfter(/databases/$(database)/documents/supplierRecharges/$(rechargeId)).data;
      return isAdmin()
        && hasValidSupplierAccountValues(accountId)
        && recharge.supplierId == accountId
        && request.resource.data.totalOwed == recharge.amountOwed
        && request.resource.data.totalPaid == 0
        && request.resource.data.totalRecharged == recharge.receivedAmount
        && request.resource.data.rechargeCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidSupplierAccountRechargeUpdate(accountId) {
      let rechargeId = request.resource.data.lastRechargeId;
      let recharge = getAfter(/databases/$(database)/documents/supplierRecharges/$(rechargeId)).data;
      return isAdmin()
        && hasValidSupplierAccountValues(accountId)
        && recharge.supplierId == accountId
        && rechargeId != resource.data.get('lastRechargeId', null)
        && request.resource.data.totalOwed == resource.data.totalOwed + recharge.amountOwed
        && request.resource.data.totalPaid == resource.data.totalPaid
        && request.resource.data.totalRecharged == resource.data.totalRecharged + recharge.receivedAmount
        && request.resource.data.rechargeCount == resource.data.rechargeCount + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidSupplierPaymentValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.supplierId is string
        && positiveFinanceAmount(request.resource.data.amount)
        && validFinancePaymentChannel(request.resource.data.paymentChannel)
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 3
        && request.resource.data.paymentReference.size() <= 120
        && request.resource.data.paidAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidSupplierPaymentCreation() {
      let account = get(/databases/$(database)/documents/supplierAccounts/$(request.resource.data.supplierId)).data;
      return isAdmin()
        && hasValidSupplierPaymentValues()
        && request.resource.data.amount <= account.totalOwed - account.totalPaid;
    }

    function isValidSupplierAccountPaymentUpdate(accountId) {
      let paymentId = request.resource.data.lastPaymentId;
      let payment = getAfter(/databases/$(database)/documents/supplierPayments/$(paymentId)).data;
      return isAdmin()
        && hasValidSupplierAccountValues(accountId)
        && payment.supplierId == accountId
        && paymentId != resource.data.get('lastPaymentId', null)
        && request.resource.data.totalOwed == resource.data.totalOwed
        && request.resource.data.totalPaid == resource.data.totalPaid + payment.amount
        && request.resource.data.totalPaid <= request.resource.data.totalOwed
        && request.resource.data.totalRecharged == resource.data.totalRecharged
        && request.resource.data.rechargeCount == resource.data.rechargeCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAdminSupplierRechargeNetworkTransactionCreation(transactionId) {
      let rechargeId = request.resource.data.supplierRechargeId;
      let recharge = getAfter(/databases/$(database)/documents/supplierRecharges/$(rechargeId)).data;
      return isAdmin()
        && hasValidNetworkTransactionValues()
        && request.resource.data.type == 'supplierRecharge'
        && request.resource.data.direction == 'incoming'
        && request.resource.data.createdByRole == 'admin'
        && transactionId == 'recharge_' + rechargeId
        && request.resource.data.supplierId == recharge.supplierId
        && request.resource.data.agentId == recharge.agentId
        && request.resource.data.network == recharge.network
        && request.resource.data.amount == recharge.receivedAmount
        && request.resource.data.capacityBefore == recharge.capacityBefore
        && request.resource.data.capacityAfter == recharge.capacityAfter;
    }

    function hasValidCustomerCreditValues(creditId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == creditId
        && positiveFinanceAmount(request.resource.data.amount)
        && financeAmount(request.resource.data.paidAmount)
        && request.resource.data.paidAmount <= request.resource.data.amount
        && request.resource.data.status in ['open', 'partial', 'settled']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidCustomerCreditCreation(creditId) {
      let orderBefore = get(/databases/$(database)/documents/orders/$(creditId)).data;
      return isAdmin()
        && hasValidCustomerCreditValues(creditId)
        && orderBefore.status in ['awaitingPayment', 'paymentToVerify', 'expired']
        && !(orderBefore.paymentStatus in ['confirmed', 'credit'])
        && request.resource.data.orderReference == orderBefore.reference
        && request.resource.data.amount == orderBefore.amount
        && request.resource.data.paidAmount == 0
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function hasValidCustomerCreditSettlementValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.creditId is string
        && request.resource.data.orderId is string
        && positiveFinanceAmount(request.resource.data.amount)
        && validFinancePaymentChannel(request.resource.data.paymentChannel)
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 3
        && request.resource.data.paymentReference.size() <= 120
        && request.resource.data.paidAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidCustomerCreditSettlementCreation() {
      let credit = get(/databases/$(database)/documents/customerCredits/$(request.resource.data.creditId)).data;
      return isAdmin()
        && hasValidCustomerCreditSettlementValues()
        && request.resource.data.orderId == credit.orderId
        && request.resource.data.orderReference == credit.orderReference
        && request.resource.data.amount <= credit.amount - credit.paidAmount;
    }

    function isValidCustomerCreditSettlementUpdate(creditId) {
      let settlementId = request.resource.data.lastSettlementId;
      let settlement = getAfter(/databases/$(database)/documents/customerCreditSettlements/$(settlementId)).data;
      let nextPaid = resource.data.paidAmount + settlement.amount;
      return isAdmin()
        && hasValidCustomerCreditValues(creditId)
        && settlement.creditId == creditId
        && settlementId != resource.data.get('lastSettlementId', null)
        && request.resource.data.paidAmount == nextPaid
        && nextPaid <= resource.data.amount
        && (
          (nextPaid == resource.data.amount
            && request.resource.data.status == 'settled'
            && request.resource.data.get('settledAt', null) == request.time)
          ||
          (nextPaid < resource.data.amount
            && request.resource.data.status == 'partial'
            && request.resource.data.get('settledAt', null) == null)
        )
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidFinanceExpenseValues() {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.category in [
          'transport', 'internet', 'electricity', 'maintenance', 'salary',
          'communication', 'fees', 'marketing', 'office', 'other'
        ]
        && positiveFinanceAmount(request.resource.data.amount)
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && validFinancePaymentChannel(request.resource.data.paymentChannel)
        && (
          request.resource.data.paymentChannel != 'wave'
          || (
            request.resource.data.get('paymentReference', null) is string
            && request.resource.data.get('paymentReference', '').size() >= 3
          )
        )
        && request.resource.data.spentAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function hasValidWaveBalanceAdjustmentValues() {
      return isAdmin()
        && request.resource.data.schemaVersion == 1
        && financeAmount(request.resource.data.previousOpeningBalance)
        && financeAmount(request.resource.data.openingBalance)
        && request.resource.data.effectiveAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function waveSettingMatchesAdjustment(settingId) {
      let adjustmentId = request.resource.data.lastAdjustmentId;
      let adjustment = getAfter(/databases/$(database)/documents/waveBalanceAdjustments/$(adjustmentId)).data;
      return settingId == 'wave'
        && request.resource.data.schemaVersion == 1
        && financeAmount(request.resource.data.openingBalance)
        && request.resource.data.effectiveAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && adjustment.openingBalance == request.resource.data.openingBalance
        && adjustment.effectiveAt == request.time
        && adjustment.createdBy == request.auth.uid;
    }

    function isValidWaveFinanceSettingCreation(settingId) {
      let adjustmentId = request.resource.data.lastAdjustmentId;
      let adjustment = getAfter(/databases/$(database)/documents/waveBalanceAdjustments/$(adjustmentId)).data;
      return isAdmin()
        && waveSettingMatchesAdjustment(settingId)
        && adjustment.previousOpeningBalance == 0;
    }

    function isValidWaveFinanceSettingUpdate(settingId) {
      let adjustmentId = request.resource.data.lastAdjustmentId;
      let adjustment = getAfter(/databases/$(database)/documents/waveBalanceAdjustments/$(adjustmentId)).data;
      return isAdmin()
        && waveSettingMatchesAdjustment(settingId)
        && adjustment.previousOpeningBalance == resource.data.openingBalance;
    }

    function hasValidDailyClosingValues(closingId) {
      return request.resource.data.schemaVersion == 1
        && request.resource.data.dateKey == closingId
        && closingId is string
        && closingId.size() == 8
        && request.resource.data.waveTheoreticalBalance is int
        && request.resource.data.waveActualBalance is int
        && request.resource.data.waveActualBalance >= 0
        && request.resource.data.waveDifference
          == request.resource.data.waveActualBalance - request.resource.data.waveTheoreticalBalance
        && (
          request.resource.data.waveDifference == 0
          || (
            request.resource.data.get('waveDifferenceNote', null) is string
            && request.resource.data.get('waveDifferenceNote', '').size() >= 3
          )
        )
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy == request.auth.uid;
    }

    function hasValidCommissionPayoutValues(payoutId) {
      let agentId = request.resource.data.agentId;
      let account = get(
        /databases/$(database)/documents/commissionAccounts/$(agentId)
      ).data;

      return isAdmin()
        && payoutId is string
        && payoutId.matches('^wave_[A-Za-z0-9_-]+$')
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'agentId',
          'agentName',
          'amount',
          'paymentChannel',
          'paymentReference',
          'note',
          'paidAt',
          'createdBy',
          'createdByName',
          'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && agentId is string
        && agentId.size() >= 1
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.paymentChannel == 'wave'
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 3
        && request.resource.data.paymentReference.size() <= 120
        && (
          request.resource.data.get('note', null) == null
          || (
            request.resource.data.get('note', null) is string
            && request.resource.data.get('note', '').size() <= 500
          )
        )
        && request.resource.data.paidAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() >= 2
        && request.resource.data.createdByName.size() <= 80
        && request.resource.data.createdAt == request.time
        && account.agentId == agentId
        && account.agentName == request.resource.data.agentName
        && request.resource.data.amount
          <= account.earnedTotal - account.paidTotal;
    }

    function isValidAdminCommissionAccountPayoutUpdate(accountId) {
      let payoutId = request.resource.data.get('lastPayoutId', '');
      let payout = getAfter(
        /databases/$(database)/documents/commissionPayouts/$(payoutId)
      ).data;

      return isAdmin()
        && hasValidCommissionAccountValues(accountId)
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.agentName == resource.data.agentName
        && request.resource.data.earnedTotal == resource.data.earnedTotal
        && request.resource.data.earnedTransactions
          == resource.data.earnedTransactions
        && request.resource.data.get('lastCommissionOrderId', null)
          == resource.data.get('lastCommissionOrderId', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && payoutId is string
        && payoutId.size() >= 1
        && payoutId != resource.data.get('lastPayoutId', null)
        && payout.agentId == accountId
        && payout.agentName == resource.data.agentName
        && payout.createdBy == request.auth.uid
        && payout.paidAt == request.time
        && request.resource.data.paidTotal
          == resource.data.paidTotal + payout.amount
        && request.resource.data.paidTotal <= request.resource.data.earnedTotal
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paidTotal',
          'lastPayoutId',
          'updatedAt'
        ]);
    }

    match /commissions/{commissionId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow create: if isValidAgentCommissionCreation(commissionId);
      allow update, delete: if false;
    }

    match /commissionAccounts/{accountId} {
      allow get: if isAdmin()
        || (isAgent() && request.auth.uid == accountId);
      allow list: if isAdmin()
        || (isAgent() && request.auth.uid == accountId);
      allow create: if isValidAgentCommissionAccountCreation(accountId);
      allow update: if isValidAgentCommissionAccountUpdate(accountId)
        || isValidAdminCommissionAccountPayoutUpdate(accountId);
      allow delete: if false;
    }

    match /commissionPayouts/{payoutId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow create: if hasValidCommissionPayoutValues(payoutId);
      allow update, delete: if false;
    }

    match /financeSuppliers/{supplierId} {
      allow get, list: if isAdmin();
      allow create: if isValidFinanceSupplierCreation();
      allow update: if isValidFinanceSupplierUpdate();
      allow delete: if false;
    }

    match /supplierRecharges/{rechargeId} {
      allow get, list: if isAdmin();
      allow create: if isValidSupplierRechargeCreation();
      allow update, delete: if false;
    }

    match /supplierAccounts/{accountId} {
      allow get, list: if isAdmin();
      allow create: if isValidSupplierAccountCreation(accountId);
      allow update: if isValidSupplierAccountRechargeUpdate(accountId)
        || isValidSupplierAccountPaymentUpdate(accountId);
      allow delete: if false;
    }

    match /supplierPayments/{paymentId} {
      allow get, list: if isAdmin();
      allow create: if isValidSupplierPaymentCreation();
      allow update, delete: if false;
    }

    match /customerCredits/{creditId} {
      allow get, list: if isAdmin();
      allow create: if isValidCustomerCreditCreation(creditId);
      allow update: if isValidCustomerCreditSettlementUpdate(creditId);
      allow delete: if false;
    }

    match /customerCreditSettlements/{settlementId} {
      allow get, list: if isAdmin();
      allow create: if isValidCustomerCreditSettlementCreation();
      allow update, delete: if false;
    }

    match /financeExpenses/{expenseId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && hasValidFinanceExpenseValues();
      allow update, delete: if false;
    }

    match /waveBalanceAdjustments/{adjustmentId} {
      allow get, list: if isAdmin();
      allow create: if hasValidWaveBalanceAdjustmentValues();
      allow update, delete: if false;
    }

    match /financeSettings/{settingId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isValidWaveFinanceSettingCreation(settingId);
      allow update: if isValidWaveFinanceSettingUpdate(settingId);
      allow delete: if false;
    }

    match /dailyFinancialClosings/{closingId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && hasValidDailyClosingValues(closingId);
      allow update, delete: if false;
    }

    match /networkTransactions/{transactionId} {
      allow get, list: if isAdmin();
      allow create: if isValidAgentOrderNetworkTransactionCreation(transactionId)
        || isValidAdminSupplierRechargeNetworkTransactionCreation(transactionId)
        || isValidManualNetworkAdjustmentCreation();
      allow update, delete: if false;
    }

    match /refunds/{refundId} {
      allow get, list: if isAdmin();
      allow create: if isValidAdminRefundCreation(refundId);
      allow update: if isValidAdminRefundUpdate();
      allow delete: if false;
    }

    match /supportRequests/{requestId} {
      allow get: if isStaff()
        || (
          isSignedIn()
          && resource.data.customerAuthUid == request.auth.uid
        );
      allow list: if isStaff();
      allow create: if isValidCustomerSupportRequestCreation();
      allow update: if isValidAdminSupportRequestUpdate();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if isValidCustomerOrderCreation()
        || isValidStaffOrderCreation(orderId);
      allow get: if isOrderOwner()
        || hasRecoveredOrderAccess(orderId)
        || isStaff()
        || (
          isAgent()
          && resource.data.get('assignedAgentId', null) == request.auth.uid
        );
      allow list: if isStaff()
        || isOrderOwner()
        || (
          isAgent()
          && resource.data.get('assignedAgentId', null) == request.auth.uid
        );
      // Les actions client sont testées en premier. Un client Web utilise
      // Firebase Anonymous Auth et ne possède pas de document /users/{uid}.
      // Cela évite d'évaluer inutilement toutes les règles Agent (et leurs
      // lectures de profil) avant une déclaration de paiement auditée.
      // L'affectation automatique est isolee du reste des transitions.
      // Si la requete est automatique, aucune autre branche couteuse n'est
      // evaluee apres elle, meme si sa validation echoue.
      allow update: if (
          isAgentHoldTransitionRequest()
          && isValidAgentProcessingHold()
        ) || (
          !isAgentHoldTransitionRequest()
          && isAdminFailedOrderRequeueRequest()
          && isValidAdminFailedOrderRequeue(orderId)
        ) || (
          !isAgentHoldTransitionRequest()
          && !isAdminFailedOrderRequeueRequest()
          && isAutomaticAssignmentTransitionRequest()
          && (
            (
              request.resource.data.get('assignedAgentId', null) == request.auth.uid
              && isValidAgentAutomaticSelfAssignment(orderId)
            )
            || (
              request.resource.data.get('assignedAgentId', null) != request.auth.uid
              && isValidStaffAutomaticAssignment(orderId)
            )
          )
        ) || (
          !isAgentHoldTransitionRequest()
          && !isAdminFailedOrderRequeueRequest()
          && !isAutomaticAssignmentTransitionRequest()
          && (
            isValidCustomerPaymentDeclaration(orderId)
            || isValidCustomerExpiration()
            || isValidAdminCreditAuthorization(orderId)
            || isValidStaffPaymentConfirmation(orderId)
            || (
              isManualAssignmentTransitionRequest()
              && isValidAdminManualAssignment(orderId)
            )
            || isValidAgentProcessingSuccess(orderId)
            || isValidAgentProcessingFailure(orderId)
            || isValidAgentProofAuditUpdate()
            || isValidAgentAssignmentAcceptance(orderId)
            || isValidAgentAssignmentRefusal(orderId)
            || isValidAgentProcessingStart(orderId)
            || isValidAgentProcessingResume(orderId)
            || isValidStaffManualAssignmentFallback()
            || isValidStaffOrderUpdate(orderId)
          )
        );
      allow delete: if false;
    }

    match /orderAssignments/{assignmentId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      // Même principe : ne jamais évaluer la branche manuelle pendant
      // une affectation automatique. Cela évite des lectures getAfter/isAdmin
      // inutiles dans une transaction qui écrit déjà plusieurs documents.
      allow create: if (
          request.resource.data.get('mode', null) == 'manual'
          && isValidManualAssignmentEventCreation()
        ) || (
          request.resource.data.get('mode', null) == 'automatic'
          && isValidAutomaticAssignmentEventCreation()
        );
      allow update: if isValidAgentAssignmentEventCompletion()
        || isValidAgentAssignmentEventAcceptance()
        || isValidAgentAssignmentEventRefusal();
      allow delete: if false;
    }

    match /autoAssignmentQueue/{orderId} {
      allow get, list: if isStaff() || isAgent();
      allow create, update: if (
          isStaff()
          && hasValidAutomaticQueueValues(orderId)
        ) || isValidAgentQueueRecreationAfterRefusal(orderId);
      allow delete: if isStaff()
        || isValidAgentAutomaticQueueDelete(orderId);
    }

    match /orderProofs/{orderId} {
      allow get: if isStaff()
        || (
          isAgent()
          && exists(
            /databases/$(database)/documents/orders/$(orderId)
          )
          && get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.get('assignedAgentId', null) == request.auth.uid
        );
      allow list: if isStaff();
      allow create: if isValidAgentOrderProofCreation(orderId);
      allow update: if isValidAgentOrderProofUpdate(orderId);
      allow delete: if false;
    }

    match /orderEvents/{eventId} {
      allow get: if isStaff()
        || (
          isAgent()
          && resource.data.actorId == request.auth.uid
        );
      allow list: if isStaff()
        || (
          isAgent()
          && resource.data.actorId == request.auth.uid
        );
      allow create: if (
          request.resource.data.get('type', '') == 'PUT_ON_HOLD'
          && isValidAgentPutOnHoldEvent()
        ) || (
          request.resource.data.get('type', '') == 'REASSIGNMENT_REQUESTED'
          && isValidAdminReassignmentRequestedEvent()
        ) || (
          !(request.resource.data.get('type', '') in [
            'PUT_ON_HOLD',
            'REASSIGNMENT_REQUESTED'
          ])
          && isValidOrderEventCreation(eventId)
        );
      allow update, delete: if false;
    }

    match /offers/{offerId} {
      allow get, list: if isStaff() || resource.data.isActive == true;
      allow create: if isValidOfferCreation();
      allow update: if isValidOfferUpdate();
      allow delete: if false;
    }

    match /agentProfiles/{agentId} {
      allow get, list: if isStaff()
        || (isAgent() && request.auth.uid == agentId);
      allow create: if isValidAdminAgentProfileCreation(agentId);
      allow update: if isValidAdminAgentProfileUpdate(agentId)
        || isValidAgentOperationalUpdate(agentId);
      allow delete: if false;
    }

    match /zones/{zoneId} {
      allow get, list: if isStaff() || isAgent();
      allow create: if isValidZoneCreation();
      allow update: if isValidZoneUpdate();
      allow delete: if false;
    }

    match /agentIssues/{issueId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow create: if isValidAgentIssueCreation();
      allow update: if isValidAdminAgentIssueUpdate();
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isStaff()
        );
      allow list: if isStaff();
      allow create: if isValidPendingStaffProfileCreation(userId);
      allow update: if isValidAdminUserUpdate(userId);
      allow delete: if false;
    }
  }
}
