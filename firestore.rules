rules_version = '2';
// PHASE 9E AUTO ASSIGNMENT FIX V2 - artefacts unidirectionnels

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function staffProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isStaff() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role in ['operator', 'supervisor', 'admin'];
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role == 'admin';
    }

    function isAgent() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && staffProfile().isActive == true
        && staffProfile().role == 'agent';
    }

    function isCurrentAssignedAgent() {
      return isAgent()
        && resource.data.get('assignedAgentId', null) == request.auth.uid;
    }

    function isOrderOwner() {
      return isSignedIn()
        && resource.data.customerAuthUid == request.auth.uid;
    }

    function hasValidOrderKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'reference',
        'source',
        'customerAuthUid',
        'clientName',
        'clientWhatsappPhone',
        'service',
        'network',
        'operationType',
        'offerId',
        'offerLabel',
        'isCustomOffer',
        'amount',
        'beneficiaryPhone',
        'status',
        'paymentStatus',
        'createdAt',
        'updatedAt',
        'paymentRequestSentAt',
        'paymentDeclaredAt',
        'paymentPayerName',
        'paymentPayerPhone',
        'paymentApproximateTime',
        'paymentDeclaredReference',
        'expiresAt',
        'expiredAt',
        'paymentConfirmedAt',
        'paidAt',
        'paymentReference',
        'originalWhatsappMessage',
        'internalNotes',
        'takenByUserId',
        'takenAt',
        'completedAt',
        'failureReason',
        'observation',
        'customerConfirmationStatus',
        'customerConfirmationCompletedAt',
        'assignedAgentId',
        'assignedAgentName',
        'assignedByUserId',
        'assignedAt',
        'assignmentMode',
        'assignmentStatus',
        'lastAssignmentRefusalReason',
        'lastAssignmentRefusedAt',
        'lastAssignmentRefusedAgentId',
        'lastHoldReason',
        'lastHeldAt',
        'lastResumedAt',
        'lastEventId',
        'lastEventType',
        'lastEventAt'
      ]);
    }


    function hasValidOrderAssignmentValues() {
      return (
          request.resource.data.get('assignedAgentId', null) == null
          || request.resource.data.get('assignedAgentId', null) is string
        )
        && (
          request.resource.data.get('assignedAgentName', null) == null
          || request.resource.data.get('assignedAgentName', null) is string
        )
        && (
          request.resource.data.get('assignedByUserId', null) == null
          || request.resource.data.get('assignedByUserId', null) is string
        )
        && (
          request.resource.data.get('assignedAt', null) == null
          || request.resource.data.get('assignedAt', null) is timestamp
        )
        && (
          request.resource.data.get('assignmentMode', null) == null
          || request.resource.data.get('assignmentMode', null) in [
            'manual',
            'automatic'
          ]
        )
        && request.resource.data.get('assignmentStatus', 'unassigned') in [
          'unassigned',
          'assigned',
          'accepted',
          'refused'
        ]
        && (
          request.resource.data.get('lastAssignmentRefusalReason', null) == null
          || (
            request.resource.data.get('lastAssignmentRefusalReason', null) is string
            && request.resource.data.get('lastAssignmentRefusalReason', null).size() >= 3
            && request.resource.data.get('lastAssignmentRefusalReason', null).size() <= 500
          )
        )
        && (
          request.resource.data.get('lastAssignmentRefusedAt', null) == null
          || request.resource.data.get('lastAssignmentRefusedAt', null) is timestamp
        )
        && (
          request.resource.data.get('lastAssignmentRefusedAgentId', null) == null
          || request.resource.data.get('lastAssignmentRefusedAgentId', null) is string
        )
        && (
          request.resource.data.get('lastHoldReason', null) == null
          || (
            request.resource.data.get('lastHoldReason', null) is string
            && request.resource.data.get('lastHoldReason', null).size() >= 3
            && request.resource.data.get('lastHoldReason', null).size() <= 300
          )
        )
        && (
          request.resource.data.get('lastHeldAt', null) == null
          || request.resource.data.get('lastHeldAt', null) is timestamp
        )
        && (
          request.resource.data.get('lastResumedAt', null) == null
          || request.resource.data.get('lastResumedAt', null) is timestamp
        );
    }

    function hasValidOrderAuditValues() {
      return (
          request.resource.data.get('lastEventId', null) == null
          || (
            request.resource.data.get('lastEventId', null) is string
            && request.resource.data.get('lastEventId', null).size() >= 8
            && request.resource.data.get('lastEventId', null).size() <= 120
          )
        )
        && (
          request.resource.data.get('lastEventType', null) == null
          || request.resource.data.get('lastEventType', null) in [
            'ORDER_CREATED',
            'PAYMENT_DECLARED',
            'PAYMENT_CONFIRMED',
            'ASSIGNED',
            'ASSIGNMENT_ACCEPTED',
            'ASSIGNMENT_REFUSED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_RESUMED',
            'PROOF_ADDED',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED',
            'CUSTOMER_CONTACTED'
          ]
        )
        && (
          request.resource.data.get('lastEventAt', null) == null
          || request.resource.data.get('lastEventAt', null) is timestamp
        );
    }

    function hasValidCommonOrderValues() {
      return hasValidOrderKeys()
        && hasValidOrderAssignmentValues()
        && hasValidOrderAuditValues()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 12
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientWhatsappPhone is string
        && request.resource.data['service'] in [
          'unitTransfer',
          'internetSubscription',
          'calls',
          'other'
        ]
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.operationType in [
          'unitTransfer',
          'internetSubscription',
          'callBundle',
          'mixedBundle',
          'other'
        ]
        && (
          request.resource.data.offerId == null
          || request.resource.data.offerId is string
        )
        && request.resource.data.offerLabel is string
        && request.resource.data.offerLabel.size() >= 2
        && request.resource.data.offerLabel.size() <= 200
        && request.resource.data.isCustomOffer is bool
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.beneficiaryPhone is string
        && request.resource.data.expiresAt is timestamp
        && (
          request.resource.data.get('expiredAt', null) == null
          || request.resource.data.get('expiredAt', null) is timestamp
        )
        && request.resource.data.status in [
          'awaitingPayment',
          'paymentToVerify',
          'paidReady',
          'inProgress',
          'onHold',
          'awaitingCustomerConfirmation',
          'completed',
          'failed',
          'expired',
          'cancelled',
          'refundPending',
          'refunded'
        ]
        && request.resource.data.paymentStatus in [
          'notDeclared',
          'pending',
          'declared',
          'confirmed',
          'rejected',
          'expired'
        ]
        && request.resource.data.customerConfirmationStatus in [
          'pending',
          'sent',
          'skipped'
        ];
    }

    function hasMatchingOrderEvent(orderId, eventType) {
      let eventId = request.resource.data.get('lastEventId', null);
      let event = getAfter(
        /databases/$(database)/documents/orderEvents/$(eventId)
      ).data;

      return eventId is string
        && request.resource.data.get('lastEventType', null) == eventType
        && request.resource.data.get('lastEventAt', null) == request.time
        && event.orderId == orderId
        && event.orderReference == request.resource.data.reference
        && event.type == eventType
        && event.createdAt == request.time;
    }

    function auditLinkIsUnchanged() {
      return request.resource.data.get('lastEventId', null)
          == resource.data.get('lastEventId', null)
        && request.resource.data.get('lastEventType', null)
          == resource.data.get('lastEventType', null)
        && request.resource.data.get('lastEventAt', null)
          == resource.data.get('lastEventAt', null);
    }

    function isValidCustomerServiceOperationPair() {
      return (
        request.resource.data['service'] == 'unitTransfer'
        && request.resource.data.operationType == 'unitTransfer'
      ) || (
        request.resource.data['service'] == 'internetSubscription'
        && request.resource.data.operationType == 'internetSubscription'
      ) || (
        request.resource.data['service'] == 'calls'
        && request.resource.data.operationType in ['callBundle', 'mixedBundle']
      );
    }

    function activeOfferMatchesOrderSnapshot(offerId) {
      let offer = get(
        /databases/$(database)/documents/offers/$(offerId)
      ).data;

      return offer.isActive == true
        && offer.network == request.resource.data.network
        && offer['service'] == request.resource.data['service']
        && offer.catalogLabel == request.resource.data.offerLabel
        && offer.sellingPrice == request.resource.data.amount;
    }

    function isValidOfferSnapshotAtCreation() {
      let offerId = request.resource.data.offerId;

      return (
        request.resource.data.isCustomOffer == true
        && offerId == null
        && isValidCustomerServiceOperationPair()
      ) || (
        request.resource.data.isCustomOffer == false
        && request.resource.data['service'] == 'unitTransfer'
        && request.resource.data.operationType == 'unitTransfer'
        && offerId == null
      ) || (
        request.resource.data.isCustomOffer == false
        && request.resource.data['service'] in ['internetSubscription', 'calls']
        && isValidCustomerServiceOperationPair()
        && offerId is string
        && activeOfferMatchesOrderSnapshot(offerId)
      );
    }

    // Validation dédiée à la création Web. Elle correspond exactement au
    // document construit par FirestoreCustomerOrderRepository._buildOrderData
    // + les trois champs d'audit ajoutés par _auditLinkData.
    //
    // Important : aucune lecture de orderEvents n'est faite ici. Le document
    // ORDER_CREATED écrit dans le même batch possède sa propre règle stricte.
    // Cela évite qu'une création de commande dépende de l'autorisation d'une
    // autre création pendant l'évaluation du même batch.
    function isValidCustomerOrderCreation(orderId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'reference',
          'source',
          'customerAuthUid',
          'clientName',
          'clientWhatsappPhone',
          'service',
          'network',
          'operationType',
          'offerId',
          'offerLabel',
          'isCustomOffer',
          'amount',
          'beneficiaryPhone',
          'status',
          'paymentStatus',
          'createdAt',
          'updatedAt',
          'paymentRequestSentAt',
          'paymentDeclaredAt',
          'paymentPayerName',
          'paymentPayerPhone',
          'paymentApproximateTime',
          'paymentDeclaredReference',
          'expiresAt',
          'expiredAt',
          'paymentConfirmedAt',
          'paidAt',
          'paymentReference',
          'originalWhatsappMessage',
          'internalNotes',
          'takenByUserId',
          'takenAt',
          'completedAt',
          'failureReason',
          'observation',
          'customerConfirmationStatus',
          'customerConfirmationCompletedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 12
        && request.resource.data.reference.size() <= 40
        && request.resource.data.source == 'customerWeb'
        && request.resource.data.customerAuthUid == request.auth.uid
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientWhatsappPhone is string
        && request.resource.data['service'] in [
          'unitTransfer',
          'internetSubscription',
          'calls'
        ]
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && isValidCustomerServiceOperationPair()
        && request.resource.data.offerLabel is string
        && request.resource.data.offerLabel.size() >= 2
        && request.resource.data.offerLabel.size() <= 200
        && request.resource.data.isCustomOffer is bool
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.beneficiaryPhone is string
        && isValidOfferSnapshotAtCreation()
        && request.resource.data.status == 'awaitingPayment'
        && request.resource.data.paymentStatus == 'notDeclared'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentRequestSentAt == null
        && request.resource.data.paymentDeclaredAt == null
        && request.resource.data.paymentPayerName == null
        && request.resource.data.paymentPayerPhone == null
        && request.resource.data.paymentApproximateTime == null
        && request.resource.data.paymentDeclaredReference == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiredAt == null
        && request.resource.data.paymentConfirmedAt == null
        && request.resource.data.paidAt == null
        && request.resource.data.paymentReference == null
        && request.resource.data.originalWhatsappMessage == null
        && request.resource.data.internalNotes == null
        && request.resource.data.takenByUserId == null
        && request.resource.data.takenAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.failureReason == null
        && request.resource.data.observation == null
        && request.resource.data.customerConfirmationStatus == 'pending'
        && request.resource.data.customerConfirmationCompletedAt == null
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId.size() >= 8
        && request.resource.data.lastEventId.size() <= 120
        && request.resource.data.lastEventType == 'ORDER_CREATED'
        && request.resource.data.lastEventAt == request.time;
    }

    function isValidStaffOfferReferenceAtCreation() {
      let offerId = request.resource.data.offerId;

      return request.resource.data.isCustomOffer == true
        || request.resource.data['service'] == 'unitTransfer'
        || (
          request.resource.data.isCustomOffer == false
          && offerId is string
          && exists(
            /databases/$(database)/documents/offers/$(offerId)
          )
          && get(
            /databases/$(database)/documents/offers/$(offerId)
          ).data.isActive == true
        );
    }

    function isValidStaffOrderCreation(orderId) {
      return isStaff()
        && hasValidCommonOrderValues()
        && isValidStaffOfferReferenceAtCreation()
        && request.resource.data.source == 'operatorApp'
        && request.resource.data.customerAuthUid == null
        && request.resource.data.status == 'awaitingPayment'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentRequestSentAt == null
        && request.resource.data.paymentDeclaredAt == null
        && request.resource.data.paymentPayerName == null
        && request.resource.data.paymentPayerPhone == null
        && request.resource.data.paymentApproximateTime == null
        && request.resource.data.paymentDeclaredReference == null
        && request.resource.data.get('expiredAt', null) == null
        && request.resource.data.paymentConfirmedAt == null
        && request.resource.data.paidAt == null
        && request.resource.data.paymentReference == null
        && request.resource.data.takenByUserId == null
        && request.resource.data.takenAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.failureReason == null
        && request.resource.data.observation == null
        && request.resource.data.customerConfirmationStatus == 'pending'
        && request.resource.data.customerConfirmationCompletedAt == null
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignedAgentName', null) == null
        && request.resource.data.get('assignedByUserId', null) == null
        && request.resource.data.get('assignedAt', null) == null
        && request.resource.data.get('assignmentMode', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('lastAssignmentRefusalReason', null) == null
        && request.resource.data.get('lastAssignmentRefusedAt', null) == null
        && request.resource.data.get('lastHoldReason', null) == null
        && request.resource.data.get('lastHeldAt', null) == null
        && request.resource.data.get('lastResumedAt', null) == null
        && hasMatchingOrderEvent(orderId, 'ORDER_CREATED');
    }

    function immutableCoreOrderFieldsAreUnchanged() {
      return request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.source == resource.data.source
        && request.resource.data.customerAuthUid == resource.data.customerAuthUid
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.clientWhatsappPhone == resource.data.clientWhatsappPhone
        && request.resource.data['service'] == resource.data['service']
        && request.resource.data.network == resource.data.network
        && request.resource.data.operationType == resource.data.operationType
        && request.resource.data.offerId == resource.data.offerId
        && request.resource.data.offerLabel == resource.data.offerLabel
        && request.resource.data.isCustomOffer == resource.data.isCustomOffer
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.beneficiaryPhone == resource.data.beneficiaryPhone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.originalWhatsappMessage == resource.data.originalWhatsappMessage;
    }

    function onlyStaffMutableFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'updatedAt',
        'status',
        'paymentStatus',
        'paymentRequestSentAt',
        'expiredAt',
        'paymentConfirmedAt',
        'paidAt',
        'paymentReference',
        'internalNotes',
        'takenByUserId',
        'takenAt',
        'completedAt',
        'failureReason',
        'observation',
        'customerConfirmationStatus',
        'customerConfirmationCompletedAt',
        'assignedAgentId',
        'assignedAgentName',
        'assignedByUserId',
        'assignedAt',
        'assignmentMode',
        'assignmentStatus',
        'lastEventId',
        'lastEventType',
        'lastEventAt'
      ]);
    }

    function isValidStaffPaymentConfirmation(orderId) {
      // Vérifie d'abord l'état de la commande. Ainsi une affectation d'une
      // commande déjà paidReady n'effectue aucune lecture /users inutile ici.
      return resource.data.status in [
          'awaitingPayment',
          'paymentToVerify',
          'expired'
        ]
        && resource.data.paymentStatus in [
          'pending',
          'declared',
          'notDeclared',
          'expired'
        ]
        && isStaff()
        && request.resource.data.status == 'paidReady'
        && request.resource.data.paymentStatus == 'confirmed'
        && request.resource.data.get('paidAt', null) is timestamp
        && request.resource.data.get('paymentConfirmedAt', null) == request.time
        && request.resource.data.get('paymentReference', null) is string
        && request.resource.data.get('paymentReference', null).size() >= 3
        && request.resource.data.get('paymentReference', null).size() <= 120
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'paidAt',
          'paymentConfirmedAt',
          'paymentReference',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PAYMENT_CONFIRMED');
    }

    function isValidStaffOrderUpdate(orderId) {
      return isStaff()
        && hasValidCommonOrderValues()
        && immutableCoreOrderFieldsAreUnchanged()
        && onlyStaffMutableFieldsChanged()
        && request.resource.data.updatedAt == request.time
        && (
          auditLinkIsUnchanged()
          || hasMatchingOrderEvent(
            orderId,
            request.resource.data.get('lastEventType', null)
          )
        );
    }


    function targetAgentProfile(agentId) {
      return get(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      ).data;
    }

    function targetAgentUser(agentId) {
      return get(
        /databases/$(database)/documents/users/$(agentId)
      ).data;
    }

    function targetAgentHasEnoughCapacity(agentId) {
      let profile = targetAgentProfile(agentId);
      let network = request.resource.data.network;
      let amount = request.resource.data.amount;

      return (
          network == 'orange'
          && profile.orangeCapacity >= amount
        ) || (
          network == 'mtn'
          && profile.mtnCapacity >= amount
        ) || (
          network == 'moov'
          && profile.moovCapacity >= amount
        );
    }

    // Garde-fous sans lecture Firestore pour distinguer les deux
    // chemins d'affectation avant d'executer leurs validations couteuses.
    // Cela evite de consommer des get()/exists()/getAfter() du chemin manuel
    // pendant une affectation automatique (et inversement).
    function isManualAssignmentTransitionRequest() {
      return resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignmentMode', null) == 'manual';
    }

    function isAutomaticAssignmentTransitionRequest() {
      return resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignmentMode', null) == 'automatic';
    }

    function isValidAdminManualAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      let agentUserExists = exists(
        /databases/$(database)/documents/users/$(agentId)
      );
      let agentProfileExists = exists(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      );
      let agentUser = get(
        /databases/$(database)/documents/users/$(agentId)
      ).data;
      let agentProfile = get(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      ).data;
      let network = request.resource.data.network;
      let amount = request.resource.data.amount;

      // Une affectation ne doit pas revalider tout le schéma historique de la
      // commande. On valide uniquement la transition et on interdit toute
      // modification des champs métier grâce à affectedKeys + immutableCore.
      return agentId is string
        && resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignedAgentId', null) == null
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == agentId
        && request.resource.data.get('assignedAgentName', null) is string
        && request.resource.data.get('assignedAgentName', '').size() >= 2
        && request.resource.data.get('assignedAgentName', '').size() <= 80
        && request.resource.data.get('assignedByUserId', null) == request.auth.uid
        && request.resource.data.get('assignedAt', null) == request.time
        && request.resource.data.get('assignmentMode', null) == 'manual'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventType', null) == 'ASSIGNED'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.updatedAt == request.time
        && isAdmin()
        && agentUserExists
        && agentProfileExists
        && agentUser.role == 'agent'
        && agentUser.isActive == true
        && agentProfile.availability == 'available'
        && network in agentProfile.authorizedNetworks
        && network in agentProfile.activeNetworks
        && (
          (network == 'orange' && agentProfile.orangeCapacity >= amount)
          || (network == 'mtn' && agentProfile.mtnCapacity >= amount)
          || (network == 'moov' && agentProfile.moovCapacity >= amount)
        )
        && hasMatchingOrderEvent(orderId, 'ASSIGNED');
    }

    function automaticAssignmentTargetIsEligible(agentId) {
      let agentUser = get(
        /databases/$(database)/documents/users/$(agentId)
      ).data;
      let agentProfile = get(
        /databases/$(database)/documents/agentProfiles/$(agentId)
      ).data;
      let network = request.resource.data.network;
      let amount = request.resource.data.amount;

      return agentUser.role == 'agent'
        && agentUser.isActive == true
        && agentProfile.availability == 'available'
        && network in agentProfile.authorizedNetworks
        && network in agentProfile.activeNetworks
        && (
          (network == 'orange' && agentProfile.orangeCapacity >= amount)
          || (network == 'mtn' && agentProfile.mtnCapacity >= amount)
          || (network == 'moov' && agentProfile.moovCapacity >= amount)
        );
    }

    // Validation 9E sans dependance circulaire : la commande est la seule
    // ecriture qui relit les artefacts futurs. Les regles orderAssignments et
    // orderEvents valident ensuite leur propre document sans relire orders.
    function hasMatchingAutomaticAssignmentArtifacts(orderId, agentId) {
      let eventId = request.resource.data.get('lastEventId', null);
      let event = getAfter(
        /databases/$(database)/documents/orderEvents/$(eventId)
      ).data;
      let assignmentId = event.metadata.get('assignmentId', null);
      let assignment = getAfter(
        /databases/$(database)/documents/orderAssignments/$(assignmentId)
      ).data;

      return eventId is string
        && event.orderId == orderId
        && event.orderReference == request.resource.data.reference
        && event.type == 'ASSIGNED'
        && event.actorId == request.auth.uid
        && event.createdAt == request.time
        && event.metadata is map
        && event.metadata.get('agentId', null) == agentId
        && assignmentId is string
        && assignment.orderId == orderId
        && assignment.orderReference == request.resource.data.reference
        && assignment.agentId == agentId
        && assignment.agentName == request.resource.data.get('assignedAgentName', '')
        && assignment.assignedByUserId == request.auth.uid
        && assignment.mode == 'automatic'
        && assignment.status == 'assigned'
        && assignment.assignedAt == request.time
        && assignment.updatedAt == request.time;
    }

    function hasValidAutomaticAssignmentTransition(orderId, agentId) {
      return agentId is string
        && resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignedAgentId', null) == null
        && resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && resource.data.get('lastAssignmentRefusedAgentId', null) != agentId
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null) == agentId
        && request.resource.data.get('assignedAgentName', null) is string
        && request.resource.data.get('assignedAgentName', '').size() >= 2
        && request.resource.data.get('assignedAgentName', '').size() <= 80
        && request.resource.data.get('assignedByUserId', null) == request.auth.uid
        && request.resource.data.get('assignedAt', null) == request.time
        && request.resource.data.get('assignmentMode', null) == 'automatic'
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventType', null) == 'ASSIGNED'
        && request.resource.data.get('lastEventAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.updatedAt == request.time
        && automaticAssignmentTargetIsEligible(agentId)
        && hasMatchingAutomaticAssignmentArtifacts(orderId, agentId);
    }

    function isValidStaffAutomaticAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      return agentId != request.auth.uid
        && isStaff()
        && hasValidAutomaticAssignmentTransition(orderId, agentId);
    }

    function isValidAgentAutomaticSelfAssignment(orderId) {
      let agentId = request.resource.data.get('assignedAgentId', null);
      return agentId == request.auth.uid
        && isAgent()
        && hasValidAutomaticAssignmentTransition(orderId, agentId);
    }

    function isValidAgentAssignmentAcceptance(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignedAgentId', null) == request.auth.uid
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignmentStatus',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'ASSIGNMENT_ACCEPTED');
    }

    function isValidAgentAssignmentRefusal(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'assigned'
        && request.resource.data.get('assignedAgentId', null) == null
        && request.resource.data.get('assignedAgentName', null) == null
        && request.resource.data.get('assignedByUserId', null) == null
        && request.resource.data.get('assignedAt', null) == null
        && request.resource.data.get('assignmentMode', null) == null
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && request.resource.data.get('lastAssignmentRefusalReason', null) is string
        && request.resource.data.get('lastAssignmentRefusalReason', null).size() >= 3
        && request.resource.data.get('lastAssignmentRefusalReason', null).size() <= 500
        && request.resource.data.get('lastAssignmentRefusedAt', null) == request.time
        && request.resource.data.get('lastAssignmentRefusedAgentId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'assignedAgentId',
          'assignedAgentName',
          'assignedByUserId',
          'assignedAt',
          'assignmentMode',
          'assignmentStatus',
          'lastAssignmentRefusalReason',
          'lastAssignmentRefusedAt',
          'lastAssignmentRefusedAgentId',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'ASSIGNMENT_REFUSED');
    }

    function isValidAgentProcessingStart(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'paidReady'
        && resource.data.paymentStatus == 'confirmed'
        && request.resource.data.get('assignedAgentId', null) == request.auth.uid
        && request.resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && request.resource.data.status == 'inProgress'
        && request.resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.get('takenAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'takenByUserId',
          'takenAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_STARTED');
    }

    function isValidAgentProcessingResume(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'onHold'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.status == 'inProgress'
        && request.resource.data.get('lastResumedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastResumedAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_RESUMED');
    }

    function isValidAgentProcessingHold(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status == 'inProgress'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.status == 'onHold'
        && request.resource.data.get('lastHoldReason', null) is string
        && request.resource.data.get('lastHoldReason', null).size() >= 3
        && request.resource.data.get('lastHoldReason', null).size() <= 300
        && request.resource.data.get('lastHeldAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'lastHoldReason',
          'lastHeldAt',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PUT_ON_HOLD');
    }

    function hasValidAgentProofForOrder(orderId) {
      let proof = get(
        /databases/$(database)/documents/orderProofs/$(orderId)
      ).data;

      return proof.get('agentId', null) == request.auth.uid
        && proof.get('orderId', null) == orderId;
    }

    function isValidAgentProcessingSuccess(orderId) {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'awaitingCustomerConfirmation'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && isCurrentAssignedAgent()
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && hasValidAgentProofForOrder(orderId)
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('failureReason', null) == null
        && request.resource.data.get('observation', null) == null
        && request.resource.data.get('customerConfirmationStatus', 'pending') == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'failureReason',
          'observation',
          'customerConfirmationStatus',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_SUCCEEDED');
    }

    function isValidAgentProcessingFailure(orderId) {
      return resource.data.status == 'inProgress'
        && request.resource.data.status == 'failed'
        && resource.data.paymentStatus == 'confirmed'
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && isCurrentAssignedAgent()
        && resource.data.get('takenByUserId', null) == request.auth.uid
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('failureReason', null) in [
          'incorrectNumber',
          'networkUnavailable',
          'offerUnavailable',
          'insufficientBalance',
          'technicalError',
          'incorrectPayment',
          'other'
        ]
        && (
          request.resource.data.get('observation', null) == null
          || (
            request.resource.data.get('observation', null) is string
            && request.resource.data.get('observation', null).size() <= 1000
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'failureReason',
          'observation',
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && hasMatchingOrderEvent(orderId, 'PROCESSING_FAILED');
    }

    function isValidAgentProofAuditUpdate(orderId) {
      return isCurrentAssignedAgent()
        && resource.data.get('assignmentStatus', 'unassigned') == 'accepted'
        && resource.data.status in ['inProgress', 'onHold']
        && resource.data.paymentStatus == 'confirmed'
        && request.resource.data.status == resource.data.status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.get('assignedAgentId', null)
          == resource.data.get('assignedAgentId', null)
        && request.resource.data.get('assignmentStatus', 'unassigned')
          == resource.data.get('assignmentStatus', 'unassigned')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', null).size() >= 8
        && request.resource.data.get('lastEventId', null).size() <= 120
        && request.resource.data.get('lastEventType', null) == 'PROOF_ADDED'
        && request.resource.data.get('lastEventAt', null) == request.time;
    }

    function isValidCustomerPaymentDeclaration(orderId) {
      let wasExpired = resource.data.status == 'expired';
      let isLate = request.time >= resource.data.expiresAt;
      let oldExpiredAt = resource.data.get('expiredAt', null);
      let newExpiredAt = request.resource.data.get('expiredAt', null);

      // Validation volontairement locale a cette transition.
      // Le diff ci-dessous interdit deja toute modification des champs
      // metier de la commande. On ne revalide donc pas tout le schema
      // historique via hasValidCommonOrderValues()/immutableCore..., ce qui
      // pouvait faire echouer une commande pourtant valide creee par la V3.
      return isSignedIn()
        && resource.data.get('customerAuthUid', null) == request.auth.uid
        && request.resource.data.get('customerAuthUid', null) == request.auth.uid
        && resource.data.source == 'customerWeb'
        && resource.data.status in ['awaitingPayment', 'expired']
        && resource.data.paymentStatus in ['notDeclared', 'expired']
        && resource.data.get('paymentDeclaredAt', null) == null

        // Seuls les champs de declaration + audit peuvent changer.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'paymentDeclaredAt',
          'paymentPayerName',
          'paymentPayerPhone',
          'paymentApproximateTime',
          'paymentDeclaredReference',
          'expiredAt',
          'lastEventId',
          'lastEventType',
          'lastEventAt'
        ])

        && request.resource.data.status == (
          wasExpired || isLate ? 'expired' : 'paymentToVerify'
        )
        && request.resource.data.paymentStatus == 'declared'
        && request.resource.data.paymentDeclaredAt == request.time

        && request.resource.data.paymentPayerName is string
        && request.resource.data.paymentPayerName.size() >= 2
        && request.resource.data.paymentPayerName.size() <= 80

        && request.resource.data.paymentPayerPhone is string
        && request.resource.data.paymentPayerPhone.matches(
          '^[+]225(01|05|07)[0-9]{8}$'
        )

        && request.resource.data.paymentApproximateTime is string
        && request.resource.data.paymentApproximateTime.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )

        && (
          request.resource.data.paymentDeclaredReference == null
          || (
            request.resource.data.paymentDeclaredReference is string
            && request.resource.data.paymentDeclaredReference.size() <= 80
          )
        )

        && (
          (!wasExpired && !isLate && newExpiredAt == oldExpiredAt)
          || (
            (wasExpired || isLate)
            && (
              (oldExpiredAt == null && newExpiredAt == request.time)
              || (oldExpiredAt != null && newExpiredAt == oldExpiredAt)
            )
          )
        )

        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('lastEventId', null) is string
        && request.resource.data.get('lastEventId', null).size() >= 8
        && request.resource.data.get('lastEventId', null).size() <= 120
        && request.resource.data.get('lastEventType', null) == 'PAYMENT_DECLARED'
        && request.resource.data.get('lastEventAt', null) == request.time

        // L'evenement PAYMENT_DECLARED doit toujours etre cree dans la meme
        // transaction. C'est la seule lecture getAfter() de cette transition.
        && hasMatchingOrderEvent(orderId, 'PAYMENT_DECLARED');
    }

    function isValidCustomerExpiration() {
      return isOrderOwner()
        && hasValidCommonOrderValues()
        && immutableCoreOrderFieldsAreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'status',
          'paymentStatus',
          'expiredAt'
        ])
        && resource.data.source == 'customerWeb'
        && resource.data.status in ['awaitingPayment', 'paymentToVerify']
        && resource.data.paymentStatus in [
          'notDeclared',
          'pending',
          'declared',
          'expired'
        ]
        && resource.data.paymentStatus != 'confirmed'
        && request.time >= resource.data.expiresAt
        && request.resource.data.status == 'expired'
        && request.resource.data.paymentStatus == (
          resource.data.paymentStatus == 'declared' ? 'declared' : 'expired'
        )
        && request.resource.data.expiredAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidPendingStaffProfileCreation(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'name',
          'email',
          'phoneNumber',
          'role',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber == ''
        && request.resource.data.role == 'pending'
        && request.resource.data.isActive == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOfferKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'network',
        'service',
        'operationType',
        'title',
        'catalogLabel',
        'description',
        'sellingPrice',
        'details',
        'badgeLabel',
        'category',
        'validity',
        'volume',
        'minutes',
        'sms',
        'eligibility',
        'isActive',
        'displayOrder',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidOfferValues() {
      return hasValidOfferKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data['service'] in [
          'internetSubscription',
          'calls'
        ]
        && request.resource.data.operationType in [
          'internetSubscription',
          'callBundle',
          'mixedBundle'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 100
        && request.resource.data.catalogLabel is string
        && request.resource.data.catalogLabel.size() >= 2
        && request.resource.data.catalogLabel.size() <= 200
        && (
          request.resource.data.description == null
          || request.resource.data.description is string
        )
        && request.resource.data.sellingPrice is int
        && request.resource.data.sellingPrice > 0
        && request.resource.data.sellingPrice <= 1000000
        && request.resource.data.details is list
        && (
          request.resource.data.badgeLabel == null
          || request.resource.data.badgeLabel is string
        )
        && request.resource.data.category in ['internet', 'calls', 'mixed']
        && (
          request.resource.data.validity == null
          || request.resource.data.validity is string
        )
        && (
          request.resource.data.volume == null
          || request.resource.data.volume is string
        )
        && (
          request.resource.data.minutes == null
          || request.resource.data.minutes is string
        )
        && (
          request.resource.data.sms == null
          || request.resource.data.sms is string
        )
        && (
          request.resource.data.eligibility == null
          || request.resource.data.eligibility is string
        )
        && request.resource.data.isActive is bool
        && request.resource.data.displayOrder is int
        && request.resource.data.displayOrder >= 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidOfferCreation() {
      return isAdmin() && hasValidOfferValues();
    }

    function isValidOfferUpdate() {
      return isAdmin()
        && hasValidOfferValues()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidAgentProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'userId',
        'agentCode',
        'availability',
        'zoneIds',
        'authorizedNetworks',
        'activeNetworks',
        'orangeCapacity',
        'mtnCapacity',
        'moovCapacity',
        'dailyTransactionLimit',
        'maxTransactionsPerDay',
        'lastCapacityUpdateAt',
        'lastSeenAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidAgentProfileValues(agentId) {
      return hasValidAgentProfileKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.userId == agentId
        && request.resource.data.agentCode is string
        && request.resource.data.agentCode.size() >= 3
        && request.resource.data.agentCode.size() <= 30
        && request.resource.data.availability in [
          'available',
          'unavailable'
        ]
        && request.resource.data.zoneIds is list
        && request.resource.data.zoneIds.size() <= 20
        && request.resource.data.authorizedNetworks is list
        && request.resource.data.authorizedNetworks.size() <= 3
        && request.resource.data.authorizedNetworks.hasOnly([
          'orange',
          'mtn',
          'moov'
        ])
        && request.resource.data.activeNetworks is list
        && request.resource.data.activeNetworks.size() <= 3
        && request.resource.data.activeNetworks.hasOnly([
          'orange',
          'mtn',
          'moov'
        ])
        && request.resource.data.activeNetworks.hasOnly(
          request.resource.data.authorizedNetworks
        )
        && request.resource.data.orangeCapacity is int
        && request.resource.data.orangeCapacity >= 0
        && request.resource.data.orangeCapacity <= 100000000
        && request.resource.data.mtnCapacity is int
        && request.resource.data.mtnCapacity >= 0
        && request.resource.data.mtnCapacity <= 100000000
        && request.resource.data.moovCapacity is int
        && request.resource.data.moovCapacity >= 0
        && request.resource.data.moovCapacity <= 100000000
        && request.resource.data.dailyTransactionLimit is int
        && request.resource.data.dailyTransactionLimit >= 0
        && request.resource.data.dailyTransactionLimit <= 100000000
        && request.resource.data.maxTransactionsPerDay is int
        && request.resource.data.maxTransactionsPerDay >= 0
        && request.resource.data.maxTransactionsPerDay <= 10000
        && (
          request.resource.data.lastCapacityUpdateAt == null
          || request.resource.data.lastCapacityUpdateAt is timestamp
        )
        && (
          request.resource.data.lastSeenAt == null
          || request.resource.data.lastSeenAt is timestamp
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidAdminAgentProfileCreation(agentId) {
      return isAdmin()
        && getAfter(
          /databases/$(database)/documents/users/$(agentId)
        ).data.role == 'agent'
        && getAfter(
          /databases/$(database)/documents/users/$(agentId)
        ).data.isActive == true
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAdminAgentProfileUpdate(agentId) {
      return isAdmin()
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.agentCode == resource.data.agentCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentOperationalUpdate(agentId) {
      return isAgent()
        && request.auth.uid == agentId
        && hasValidAgentProfileValues(agentId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.agentCode == resource.data.agentCode
        && request.resource.data.zoneIds == resource.data.zoneIds
        && request.resource.data.authorizedNetworks == resource.data.authorizedNetworks
        && request.resource.data.dailyTransactionLimit == resource.data.dailyTransactionLimit
        && request.resource.data.maxTransactionsPerDay == resource.data.maxTransactionsPerDay
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'availability',
          'activeNetworks',
          'orangeCapacity',
          'mtnCapacity',
          'moovCapacity',
          'lastCapacityUpdateAt',
          'lastSeenAt',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidZoneKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'name',
        'city',
        'region',
        'isActive',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidZoneValues() {
      return hasValidZoneKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() >= 2
        && request.resource.data.region.size() <= 100
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidZoneCreation() {
      return isAdmin()
        && hasValidZoneValues()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidZoneUpdate() {
      return isAdmin()
        && hasValidZoneValues()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidAgentIssueKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'agentId',
        'type',
        'network',
        'description',
        'status',
        'createdAt',
        'updatedAt',
        'resolvedAt',
        'resolvedBy'
      ]);
    }

    function hasValidAgentIssueValues() {
      return hasValidAgentIssueKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.agentId is string
        && request.resource.data.type in [
          'network',
          'balance',
          'technical',
          'other'
        ]
        && (
          request.resource.data.network == null
          || request.resource.data.network in ['orange', 'mtn', 'moov']
        )
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status in [
          'open',
          'acknowledged',
          'resolved',
          'cancelled'
        ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.resolvedAt == null
          || request.resource.data.resolvedAt is timestamp
        )
        && (
          request.resource.data.resolvedBy == null
          || request.resource.data.resolvedBy is string
        );
    }

    function isValidAgentIssueCreation() {
      return isAgent()
        && request.resource.data.agentId == request.auth.uid
        && hasValidAgentIssueValues()
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null;
    }

    function isValidAdminAgentIssueUpdate() {
      return isAdmin()
        && hasValidAgentIssueValues()
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidStaffUserValues() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'name',
        'email',
        'phoneNumber',
        'role',
        'isActive',
        'createdAt',
        'updatedAt'
      ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.role in [
          'pending',
          'operator',
          'supervisor',
          'agent',
          'admin'
        ]
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidAdminUserUpdate(userId) {
      return isAdmin()
        && hasValidStaffUserValues()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.auth.uid != userId
          || (
            request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive
          )
        );
    }


    function hasValidOrderAssignmentEventKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'agentId',
        'agentName',
        'assignedByUserId',
        'mode',
        'status',
        'assignedAt',
        'acceptedAt',
        'refusedAt',
        'refusalReason',
        'completedAt',
        'updatedAt'
      ]);
    }

    function isValidManualAssignmentEventCreation() {
      let orderId = request.resource.data.orderId;
      let agentId = request.resource.data.agentId;
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return request.resource.data.schemaVersion == 1
        && orderId is string
        && agentId is string
        && request.resource.data.orderReference is string
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.assignedByUserId == request.auth.uid
        && request.resource.data.mode == 'manual'
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.refusedAt == null
        && request.resource.data.refusalReason == null
        && request.resource.data.completedAt == null
        && request.resource.data.updatedAt == request.time
        && hasValidOrderAssignmentEventKeys()
        && isAdmin()
        && orderAfter.assignedAgentId == agentId
        && orderAfter.assignedAgentName == request.resource.data.agentName
        && orderAfter.reference == request.resource.data.orderReference
        && orderAfter.assignmentStatus == 'assigned'
        && orderAfter.get('assignedAt', null) == request.time
        && orderAfter.get('lastEventType', null) == 'ASSIGNED'
        && orderAfter.get('lastEventAt', null) == request.time;
    }

    function isValidAutomaticAssignmentEventCreation() {
      let agentId = request.resource.data.agentId;
      let isSelfAssignment = agentId == request.auth.uid;

      return request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && agentId is string
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.agentName is string
        && request.resource.data.agentName.size() >= 2
        && request.resource.data.agentName.size() <= 80
        && request.resource.data.assignedByUserId == request.auth.uid
        && request.resource.data.mode == 'automatic'
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.refusedAt == null
        && request.resource.data.refusalReason == null
        && request.resource.data.completedAt == null
        && request.resource.data.updatedAt == request.time
        && hasValidOrderAssignmentEventKeys()
        && (
          (isSelfAssignment && isAgent())
          || (!isSelfAssignment && isStaff())
        );
    }

    function isValidAgentAssignmentEventAcceptance() {
      let orderId = resource.data.get('orderId', '');

      return isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && orderId is string
        && orderId.size() > 0
        && resource.data.get('status', '') == 'assigned'
        && resource.data.get('acceptedAt', null) == null
        && resource.data.get('refusedAt', null) == null
        && resource.data.get('refusalReason', null) == null
        && request.resource.data.get('status', '') == 'accepted'
        && request.resource.data.get('acceptedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'acceptedAt',
          'updatedAt'
        ])
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignedAgentId', null) == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignmentStatus', 'unassigned') == 'accepted'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventType', null) == 'ASSIGNMENT_ACCEPTED'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentAssignmentEventRefusal() {
      let orderId = resource.data.get('orderId', '');

      return isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && orderId is string
        && orderId.size() > 0
        && resource.data.get('status', '') == 'assigned'
        && resource.data.get('acceptedAt', null) == null
        && resource.data.get('refusedAt', null) == null
        && resource.data.get('refusalReason', null) == null
        && request.resource.data.get('status', '') == 'refused'
        && request.resource.data.get('acceptedAt', null) == null
        && request.resource.data.get('refusedAt', null) == request.time
        && request.resource.data.get('refusalReason', null) is string
        && request.resource.data.get('refusalReason', null).size() >= 3
        && request.resource.data.get('refusalReason', null).size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'refusedAt',
          'refusalReason',
          'updatedAt'
        ])
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignedAgentId', null) == null
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('assignmentStatus', 'unassigned') == 'unassigned'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventType', null) == 'ASSIGNMENT_REFUSED'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentAssignmentEventCompletion() {
      let orderId = resource.data.get('orderId', '');
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return resource.data.get('status', '') == 'accepted'
        && resource.data.get('completedAt', null) == null
        && request.resource.data.get('status', '') == 'accepted'
        && request.resource.data.get('completedAt', null) == request.time
        && orderId is string
        && orderId.size() > 0
        && isAgent()
        && resource.data.get('agentId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedAt',
          'updatedAt'
        ])
        && orderAfter.get('assignedAgentId', null) == request.auth.uid
        && orderAfter.get('assignmentStatus', 'unassigned') == 'accepted'
        && orderAfter.status in ['awaitingCustomerConfirmation', 'failed']
        && orderAfter.get('lastEventType', null) in [
          'PROCESSING_SUCCEEDED',
          'PROCESSING_FAILED'
        ]
        && orderAfter.get('lastEventAt', null) == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOrderProofKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'agentId',
        'fileName',
        'mimeType',
        'proofBytes',
        'sizeBytes',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidOrderProofValues(orderId) {
      return hasValidOrderProofKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 12
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() >= 1
        && request.resource.data.fileName.size() <= 120
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.proofBytes is bytes
        && request.resource.data.proofBytes.size() > 0
        && request.resource.data.proofBytes.size() <= 750000
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes == request.resource.data.proofBytes.size()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function currentAgentCanWriteProof(orderId) {
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && order.paymentStatus == 'confirmed'
        && order.status in ['inProgress', 'onHold']
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference == order.reference
        && request.resource.data.agentId == request.auth.uid;
    }

    function isValidAgentOrderProofCreation(orderId) {
      return currentAgentCanWriteProof(orderId)
        && hasValidOrderProofValues(orderId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAgentOrderProofUpdate(orderId) {
      return currentAgentCanWriteProof(orderId)
        && hasValidOrderProofValues(orderId)
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.orderReference == resource.data.orderReference
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fileName',
          'mimeType',
          'proofBytes',
          'sizeBytes',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOrderEventKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'orderId',
        'orderReference',
        'type',
        'actorId',
        'actorRole',
        'createdAt',
        'metadata'
      ]);
    }

    function hasValidOrderEventMetadata() {
      let metadata = request.resource.data.metadata;

      return metadata is map
        && metadata.keys().hasOnly([
          'source',
          'network',
          'amount',
          'paymentReference',
          'assignmentId',
          'agentId',
          'reason',
          'fileName',
          'sizeBytes',
          'failureReason',
          'observation',
          'messageSent',
          'releasedToQueue'
        ])
        && (
          metadata.get('source', null) == null
          || metadata.get('source', null) in ['customerWeb', 'operatorApp']
        )
        && (
          metadata.get('network', null) == null
          || metadata.get('network', null) in ['orange', 'mtn', 'moov']
        )
        && (
          metadata.get('amount', null) == null
          || metadata.get('amount', null) is int
        )
        && (
          metadata.get('paymentReference', null) == null
          || metadata.get('paymentReference', null) is string
        )
        && (
          metadata.get('assignmentId', null) == null
          || metadata.get('assignmentId', null) is string
        )
        && (
          metadata.get('agentId', null) == null
          || metadata.get('agentId', null) is string
        )
        && (
          metadata.get('reason', null) == null
          || (
            metadata.get('reason', null) is string
            && metadata.get('reason', null).size() <= 500
          )
        )
        && (
          metadata.get('fileName', null) == null
          || (
            metadata.get('fileName', null) is string
            && metadata.get('fileName', null).size() <= 120
          )
        )
        && (
          metadata.get('sizeBytes', null) == null
          || (
            metadata.get('sizeBytes', null) is int
            && metadata.get('sizeBytes', null) >= 0
            && metadata.get('sizeBytes', null) <= 750000
          )
        )
        && (
          metadata.get('failureReason', null) == null
          || metadata.get('failureReason', null) in [
            'incorrectNumber',
            'networkUnavailable',
            'offerUnavailable',
            'insufficientBalance',
            'technicalError',
            'incorrectPayment',
            'other'
          ]
        )
        && (
          metadata.get('observation', null) == null
          || (
            metadata.get('observation', null) is string
            && metadata.get('observation', null).size() <= 1000
          )
        )
        && (
          metadata.get('messageSent', null) == null
          || metadata.get('messageSent', null) is bool
        )
        && (
          metadata.get('releasedToQueue', null) == null
          || metadata.get('releasedToQueue', null) is bool
        );
    }

    function orderEventTypeIsValid() {
      return request.resource.data.type in [
        'ORDER_CREATED',
        'PAYMENT_DECLARED',
        'PAYMENT_CONFIRMED',
        'ASSIGNED',
        'ASSIGNMENT_ACCEPTED',
        'ASSIGNMENT_REFUSED',
        'PROCESSING_STARTED',
        'PUT_ON_HOLD',
        'PROCESSING_RESUMED',
        'PROOF_ADDED',
        'PROCESSING_SUCCEEDED',
        'PROCESSING_FAILED',
        'CUSTOMER_CONTACTED'
      ];
    }

    function orderEventActorIsValid() {
      let eventType = request.resource.data.type;
      let actorRole = request.resource.data.actorRole;

      return (
          actorRole == 'customer'
          && eventType in ['ORDER_CREATED', 'PAYMENT_DECLARED']
          && isSignedIn()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          actorRole == 'agent'
          && eventType in [
            'ASSIGNED',
            'ASSIGNMENT_ACCEPTED',
            'ASSIGNMENT_REFUSED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_RESUMED',
            'PROOF_ADDED',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED'
          ]
          && isAgent()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          // L'affectation manuelle est une action exclusivement Admin. Cette
          // branche évite de refaire isStaff + staffProfile + isAdmin pour le
          // même événement ASSIGNED.
          actorRole == 'admin'
          && eventType == 'ASSIGNED'
          && isAdmin()
          && request.resource.data.actorId == request.auth.uid
        ) || (
          actorRole in ['operator', 'supervisor', 'admin']
          && eventType in [
            'ORDER_CREATED',
            'PAYMENT_CONFIRMED',
            'ASSIGNED',
            'PROCESSING_STARTED',
            'PUT_ON_HOLD',
            'PROCESSING_SUCCEEDED',
            'PROCESSING_FAILED',
            'CUSTOMER_CONTACTED'
          ]
          && isStaff()
          && request.resource.data.actorId == request.auth.uid
          && actorRole == staffProfile().role
        );
    }

    function orderEventIsLinkedToOrder(eventId) {
      let orderId = request.resource.data.orderId;
      let order = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return order.reference == request.resource.data.orderReference
        && order.get('lastEventId', null) == eventId
        && order.get('lastEventType', null) == request.resource.data.type
        && order.get('lastEventAt', null) == request.time;
    }

    // ORDER_CREATED client : validation autonome, sans get/getAfter vers
    // orders. Le batch de l'application crée toujours orders + orderEvents,
    // mais chaque écriture peut désormais être autorisée indépendamment.
    function isValidCustomerOrderCreatedEvent() {
      let metadata = request.resource.data.metadata;

      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'type',
          'actorId',
          'actorRole',
          'createdAt',
          'metadata'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'ORDER_CREATED'
        && request.resource.data.actorRole == 'customer'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && metadata is map
        && metadata.keys().hasOnly([
          'source',
          'network',
          'amount'
        ])
        && metadata.source == 'customerWeb'
        && metadata.network in ['orange', 'mtn', 'moov']
        && metadata.amount is int
        && metadata.amount > 0
        && metadata.amount <= 1000000;
    }


    // PAYMENT_DECLARED client : la commande exige toujours l'evenement
    // correspondant via hasMatchingOrderEvent(). L'evenement, lui, valide
    // l'etat ACTUEL de la commande avec un simple get(), sans getAfter()
    // circulaire vers la mise a jour en cours.
    function isValidCustomerPaymentDeclaredEvent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isSignedIn()
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && orderId is string
        && orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'PAYMENT_DECLARED'
        && request.resource.data.actorRole == 'customer'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && hasValidOrderEventMetadata()
        && order.customerAuthUid == request.auth.uid
        && order.source == 'customerWeb'
        && order.reference == request.resource.data.orderReference
        && order.status in ['awaitingPayment', 'expired']
        && order.paymentStatus in ['notDeclared', 'expired'];
    }

    function isValidProofAddedEventForCurrentAgent() {
      let orderId = request.resource.data.orderId;
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return request.resource.data.type == 'PROOF_ADDED'
        && request.resource.data.actorRole == 'agent'
        && request.resource.data.actorId == request.auth.uid
        && isAgent()
        && order.reference == request.resource.data.orderReference
        && order.get('assignedAgentId', null) == request.auth.uid
        && order.get('assignmentStatus', 'unassigned') == 'accepted'
        && order.paymentStatus == 'confirmed'
        && order.status in ['inProgress', 'onHold'];
    }

    // ASSIGNED est valide de maniere autonome. La liaison forte avec orders
    // et orderAssignments est verifiee depuis la regle de mise a jour orders,
    // ce qui supprime les getAfter circulaires responsables des refus 9E.
    function isValidAssignedOrderEventCreation() {
      let metadata = request.resource.data.metadata;
      let agentId = metadata.get('agentId', null);
      let isSelfAssignment = agentId == request.auth.uid;

      return isSignedIn()
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.type == 'ASSIGNED'
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && metadata is map
        && metadata.keys().hasOnly([
          'assignmentId',
          'agentId'
        ])
        && metadata.get('assignmentId', null) is string
        && metadata.get('assignmentId', '').size() >= 1
        && agentId is string
        && agentId.size() >= 1
        && (
          (
            isSelfAssignment
            && request.resource.data.actorRole == 'agent'
            && isAgent()
          )
          || (
            !isSelfAssignment
            && request.resource.data.actorRole in [
              'operator',
              'supervisor',
              'admin'
            ]
            && isStaff()
            && request.resource.data.actorRole == staffProfile().role
          )
        );
    }

    function isValidOrderEventCreation(eventId) {
      return (
        request.resource.data.type == 'ORDER_CREATED'
        && request.resource.data.actorRole == 'customer'
        && isValidCustomerOrderCreatedEvent()
      ) || (
        request.resource.data.type == 'PAYMENT_DECLARED'
        && request.resource.data.actorRole == 'customer'
        && isValidCustomerPaymentDeclaredEvent()
      ) || (
        request.resource.data.type == 'ASSIGNED'
        && isValidAssignedOrderEventCreation()
      ) || (
        // ORDER_CREATED, PAYMENT_DECLARED et ASSIGNED ont leurs validations
        // dediees et ne retombent jamais dans la branche generique getAfter.
        !(request.resource.data.type in [
          'ORDER_CREATED',
          'PAYMENT_DECLARED',
          'ASSIGNED'
        ])
        && hasValidOrderEventKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() >= 1
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && orderEventTypeIsValid()
        && request.resource.data.actorId is string
        && request.resource.data.actorId.size() >= 1
        && request.resource.data.actorRole in [
          'customer',
          'operator',
          'supervisor',
          'agent',
          'admin'
        ]
        && request.resource.data.createdAt == request.time
        && hasValidOrderEventMetadata()
        && (
          (
            request.resource.data.type == 'PROOF_ADDED'
            && isValidProofAddedEventForCurrentAgent()
          )
          || (
            request.resource.data.type != 'PROOF_ADDED'
            && orderEventActorIsValid()
            && orderEventIsLinkedToOrder(eventId)
          )
        )
      );
    }

    function hasValidAutomaticQueueValues(orderId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'orderId',
          'orderReference',
          'network',
          'amount',
          'createdAt',
          'updatedAt',
          'lastRefusedAgentId'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.orderId == orderId
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() >= 8
        && request.resource.data.network in ['orange', 'mtn', 'moov']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.lastRefusedAgentId == null
          || request.resource.data.lastRefusedAgentId is string
        );
    }

    function isValidAgentQueueRecreationAfterRefusal(orderId) {
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && hasValidAutomaticQueueValues(orderId)
        && request.resource.data.lastRefusedAgentId == request.auth.uid
        && orderAfter.reference == request.resource.data.orderReference
        && orderAfter.network == request.resource.data.network
        && orderAfter.amount == request.resource.data.amount
        && orderAfter.status == 'paidReady'
        && orderAfter.paymentStatus == 'confirmed'
        && orderAfter.get('assignedAgentId', null) == null
        && orderAfter.get('assignmentStatus', 'unassigned') == 'unassigned'
        && orderAfter.get('lastAssignmentRefusedAgentId', null) == request.auth.uid
        && orderAfter.get('lastEventType', null) == 'ASSIGNMENT_REFUSED'
        && orderAfter.get('lastEventAt', null) == request.time;
    }

    function isValidAgentAutomaticQueueDelete(orderId) {
      let orderAfter = getAfter(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return isAgent()
        && orderAfter.get('assignedAgentId', null) == request.auth.uid
        && orderAfter.get('assignedByUserId', null) == request.auth.uid
        && orderAfter.get('assignmentMode', null) == 'automatic'
        && orderAfter.get('assignmentStatus', 'unassigned') == 'assigned'
        && orderAfter.get('lastEventType', null) == 'ASSIGNED'
        && orderAfter.get('lastEventAt', null) == request.time;
    }

    match /orders/{orderId} {
      allow create: if isValidCustomerOrderCreation(orderId)
        || isValidStaffOrderCreation(orderId);
      allow get: if isOrderOwner()
        || isStaff()
        || (
          isAgent()
          && resource.data.get('assignedAgentId', null) == request.auth.uid
        );
      allow list: if isStaff()
        || isOrderOwner()
        || (
          isAgent()
          && resource.data.get('assignedAgentId', null) == request.auth.uid
        );
      // Les actions client sont testées en premier. Un client Web utilise
      // Firebase Anonymous Auth et ne possède pas de document /users/{uid}.
      // Cela évite d'évaluer inutilement toutes les règles Agent (et leurs
      // lectures de profil) avant une déclaration de paiement auditée.
      // L'affectation automatique est isolee du reste des transitions.
      // Si la requete est automatique, aucune autre branche couteuse n'est
      // evaluee apres elle, meme si sa validation echoue.
      allow update: if (
          isAutomaticAssignmentTransitionRequest()
          && (
            (
              request.resource.data.get('assignedAgentId', null) == request.auth.uid
              && isValidAgentAutomaticSelfAssignment(orderId)
            )
            || (
              request.resource.data.get('assignedAgentId', null) != request.auth.uid
              && isValidStaffAutomaticAssignment(orderId)
            )
          )
        ) || (
          !isAutomaticAssignmentTransitionRequest()
          && (
            isValidCustomerPaymentDeclaration(orderId)
            || isValidCustomerExpiration()
            || isValidStaffPaymentConfirmation(orderId)
            || (
              isManualAssignmentTransitionRequest()
              && isValidAdminManualAssignment(orderId)
            )
            || isValidAgentProcessingSuccess(orderId)
            || isValidAgentProcessingFailure(orderId)
            || isValidAgentProofAuditUpdate(orderId)
            || isValidAgentAssignmentAcceptance(orderId)
            || isValidAgentAssignmentRefusal(orderId)
            || isValidAgentProcessingStart(orderId)
            || isValidAgentProcessingResume(orderId)
            || isValidAgentProcessingHold(orderId)
            || isValidStaffOrderUpdate(orderId)
          )
        );
      allow delete: if false;
    }

    match /orderAssignments/{assignmentId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      // Même principe : ne jamais évaluer la branche manuelle pendant
      // une affectation automatique. Cela évite des lectures getAfter/isAdmin
      // inutiles dans une transaction qui écrit déjà plusieurs documents.
      allow create: if (
          request.resource.data.get('mode', null) == 'manual'
          && isValidManualAssignmentEventCreation()
        ) || (
          request.resource.data.get('mode', null) == 'automatic'
          && isValidAutomaticAssignmentEventCreation()
        );
      allow update: if isValidAgentAssignmentEventCompletion()
        || isValidAgentAssignmentEventAcceptance()
        || isValidAgentAssignmentEventRefusal();
      allow delete: if false;
    }

    match /autoAssignmentQueue/{orderId} {
      allow get, list: if isStaff() || isAgent();
      allow create, update: if (
          isStaff()
          && hasValidAutomaticQueueValues(orderId)
        ) || isValidAgentQueueRecreationAfterRefusal(orderId);
      allow delete: if isStaff()
        || isValidAgentAutomaticQueueDelete(orderId);
    }

    match /orderProofs/{orderId} {
      allow get: if isStaff()
        || (
          isAgent()
          && exists(
            /databases/$(database)/documents/orders/$(orderId)
          )
          && get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.get('assignedAgentId', null) == request.auth.uid
        );
      allow list: if isStaff();
      allow create: if isValidAgentOrderProofCreation(orderId);
      allow update: if isValidAgentOrderProofUpdate(orderId);
      allow delete: if false;
    }

    match /orderEvents/{eventId} {
      allow get, list: if isStaff();
      allow create: if isValidOrderEventCreation(eventId);
      allow update, delete: if false;
    }

    match /offers/{offerId} {
      allow get, list: if isStaff() || resource.data.isActive == true;
      allow create: if isValidOfferCreation();
      allow update: if isValidOfferUpdate();
      allow delete: if false;
    }

    match /agentProfiles/{agentId} {
      allow get, list: if isStaff()
        || (isAgent() && request.auth.uid == agentId);
      allow create: if isValidAdminAgentProfileCreation(agentId);
      allow update: if isValidAdminAgentProfileUpdate(agentId)
        || isValidAgentOperationalUpdate(agentId);
      allow delete: if false;
    }

    match /zones/{zoneId} {
      allow get, list: if isStaff() || isAgent();
      allow create: if isValidZoneCreation();
      allow update: if isValidZoneUpdate();
      allow delete: if false;
    }

    match /agentIssues/{issueId} {
      allow get: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow list: if isAdmin()
        || (
          isAgent()
          && resource.data.agentId == request.auth.uid
        );
      allow create: if isValidAgentIssueCreation();
      allow update: if isValidAdminAgentIssueUpdate();
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isStaff()
        );
      allow list: if isStaff();
      allow create: if isValidPendingStaffProfileCreation(userId);
      allow update: if isValidAdminUserUpdate(userId);
      allow delete: if false;
    }
  }
}
